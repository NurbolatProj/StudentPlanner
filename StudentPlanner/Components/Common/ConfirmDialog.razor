<div class="confirm-backdrop" @onclick="Cancel" @onkeydown="HandleKeyDown">
    <section class="confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-message" tabindex="0" @onclick:stopPropagation="true">
        <h2 id="confirm-title">@Title</h2>
        <p id="confirm-message">@Message</p>
        <div class="confirm-actions">
            <button type="button" class="confirm-cancel" @onclick="Cancel">@CancelText</button>
            <button type="button" class="confirm-primary" @onclick="Confirm">@ConfirmText</button>
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "Confirm action";
    [Parameter, EditorRequired] public string Message { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private Task Confirm() => OnConfirm.InvokeAsync();
    private Task Cancel() => OnCancel.InvokeAsync();
    private Task HandleKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Cancel() : Task.CompletedTask;
}
