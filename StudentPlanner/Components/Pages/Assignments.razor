@page "/assignments"
@implements IDisposable
@using System.ComponentModel.DataAnnotations

<PageTitle>Assignments | StudentPlanner</PageTitle>

<div class="assignments-page">

    <!-- HEADER -->
    <div class="assignments-heading">
        <div>
            <span class="page-eyebrow">ACADEMIC WORKSPACE</span>
            <h1>My Assignments</h1>
            <p>Organize your tasks, track progress and never miss a deadline.</p>
        </div>

        <button class="add-button" @onclick="OpenCreateModal">
            + Add Assignment
        </button>
    </div>

    <!-- STATISTICS -->
    <div class="assignment-stats">

        <div class="assignment-stat">
            <span class="mini-stat-icon purple-bg">▤</span>
            <div>
                <span>Total Assignments</span>
                <strong>@assignments.Count</strong>
            </div>
        </div>

        <div class="assignment-stat">
            <span class="mini-stat-icon orange-bg">◷</span>
            <div>
                <span>Pending</span>
                <strong>@CountStatus("Pending")</strong>
            </div>
        </div>

        <div class="assignment-stat">
            <span class="mini-stat-icon blue-bg">↻</span>
            <div>
                <span>In Progress</span>
                <strong>@CountStatus("In Progress")</strong>
            </div>
        </div>

        <div class="assignment-stat">
            <span class="mini-stat-icon green-bg">✓</span>
            <div>
                <span>Completed</span>
                <strong>@CountStatus("Completed")</strong>
            </div>
        </div>

    </div>

    <!-- ASSIGNMENTS TABLE -->
    <section class="assignment-card">

        @if (!string.IsNullOrWhiteSpace(errorMessage)) { <p class="settings-message" role="alert">@errorMessage</p> }
        <div class="assignment-toolbar">
            <div>
                <h2>All Tasks</h2>
                <p>Manage your academic assignments</p>
            </div>

            <span class="results-count">
                @FilteredAssignments.Count() results
            </span>
        </div>

        <!-- SEARCH AND FILTERS -->
        <div class="filters">

            <div class="search-box">
                <span>⌕</span>
                <input type="text"
                       placeholder="Search assignments..."
                       @bind="searchTerm"
                       @bind:event="oninput" />
            </div>

            <select class="filter-select" @bind="statusFilter">
                <option value="All">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="InProgress">In Progress</option>
                <option value="Completed">Completed</option>
            </select>

            <select class="filter-select" @bind="priorityFilter" aria-label="Filter by priority">
                <option value="All">All Priorities</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
            </select>

            <select class="filter-select" @bind="sortBy" aria-label="Sort assignments"><option value="Due">Sort by due date</option><option value="Priority">Sort by priority</option><option value="Title">Sort by title</option></select>

            <button class="reset-button" @onclick="ResetFilters">
                Reset
            </button>

        </div>

        <!-- TABLE -->
        <div class="table-wrapper">

            <table class="assignments-table">

                <thead>
                    <tr>
                        <th>ASSIGNMENT</th>
                        <th>COURSE</th>
                        <th>DUE DATE</th>
                        <th>PRIORITY</th>
                        <th>STATUS</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var assignment in FilteredAssignments) {
                        <tr @key="assignment.Id">

                            <td>
                                <div class="assignment-name">
                                    <div class="assignment-file-icon">▤</div>

                                    <div>
                                        <strong>@assignment.Title</strong>
                                        <span>@assignment.Description</span>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="course-tag">
                                    @assignment.CourseName
                                </span>
                            </td>

                            <td>
                                <span class="due-date">
                                    @assignment.DueDate.ToString("MMM dd, yyyy")
                                </span>
                            </td>

                            <td>
                                <PriorityBadge Priority="assignment.Priority" />
                            </td>

                            <td>
                                <select class="status-select @StatusClass(assignment.Status)"
                                        @bind="assignment.Status" @bind:after="() => PersistStatus(assignment)">

                                    <option value="Pending">Pending</option>
                                    <option value="InProgress">In Progress</option>
                                    <option value="Completed">Completed</option>

                                </select>
                            </td>

                            <td>
                                <div class="action-buttons">

                                    <button class="action-button edit-action"
                                            title="Edit assignment"
                                            @onclick="() => EditAssignment(assignment)">
                                        ✎
                                    </button>

                                    <button class="action-button delete-action"
                                            title="Delete assignment"
                                            aria-label="Delete assignment @assignment.Title"
                                            @onclick="() => RequestDeleteAssignment(assignment.Id)">
                                        🗑
                                    </button>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            @if (!FilteredAssignments.Any()) {
                <div class="empty-state">
                    <span>▤</span>
                    <h3>No assignments found</h3>
                    <p>Try changing your filters or create a new assignment.</p>

                    <button class="add-button" @onclick="OpenCreateModal">
                        + Add Assignment
                    </button>
                </div>
            }

        </div>

        <div class="table-footer">
            Showing @FilteredAssignments.Count() of @assignments.Count assignments
        </div>

    </section>

</div>

@if (pendingDeleteId is not null) {
    <ConfirmDialog Title="Delete this assignment?" Message="This action cannot be undone."
                   ConfirmText="Delete assignment" OnConfirm="ConfirmDeleteAssignment" OnCancel="CancelDeleteAssignment" />
}

<!-- CREATE / EDIT MODAL -->
@if (showModal) {
    <div class="modal-overlay" @onclick="CloseModal" @onkeydown="HandleModalKeyDown">

        <div class="assignment-modal @((Layout?.isDark ?? true) ? "dark-controls" : "light-controls")" @onclick:stopPropagation="true" role="dialog" aria-modal="true" tabindex="-1">

            <div class="modal-heading">

                <div>
                    <span class="page-eyebrow">TASK MANAGEMENT</span>

                    <h2>
                        @(isEditing ? "Edit Assignment" : "Create Assignment")
                    </h2>

                    <p>Enter the assignment details below.</p>
                </div>

                <button class="modal-close" @onclick="CloseModal" @onkeydown="HandleModalKeyDown">
                    ×
                </button>

            </div>

            <EditForm Model="formModel" OnValidSubmit="SaveAssignment" class="planner-form">

                <DataAnnotationsValidator />
                @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="form-error" role="alert">@errorMessage</div> }

                <div class="form-group">
                    <label>Assignment Title *</label>

                    <InputText @bind-Value="formModel.Title"
                               class="form-input"
                               placeholder="e.g. Database Normalization" />

                    <ValidationMessage For="@(() => formModel.Title)" />
                </div>

                <div class="form-group">
                    <label>Description</label>

                    <InputTextArea @bind-Value="formModel.Description"
                                   class="form-input form-textarea"
                                   placeholder="Describe your assignment..." />
                </div>

                <div class="form-group">
                    <label>Course *</label>

                    <InputSelect @bind-Value="formModel.CourseId" class="form-input">
                        <option value="0">Select a course</option>
                        @foreach (var course in courses) { <option value="@course.Id">@course.Code — @course.Name</option> }
                    </InputSelect>

                    <ValidationMessage For="@(() => formModel.CourseId)" />
                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label>Due Date</label>

                        <InputDate @bind-Value="formModel.DueDate"
                                   class="form-input" />
                    </div>

                    <div class="form-group">
                        <label>Priority</label>

                        <InputSelect @bind-Value="formModel.Priority"
                                     class="form-input">

                            <option value="High">High</option>
                            <option value="Medium">Medium</option>
                            <option value="Low">Low</option>

                        </InputSelect>
                    </div>

                </div>

                <div class="form-group">
                    <label>Status</label>

                    <InputSelect @bind-Value="formModel.Status"
                                 class="form-input">

                        <option value="Pending">Pending</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Completed">Completed</option>

                    </InputSelect>
                </div>

                <div class="modal-actions">

                    <button type="button"
                            class="cancel-button"
                            @onclick="CloseModal" @onkeydown="HandleModalKeyDown">
                        Cancel
                    </button>

                    <button type="submit" class="add-button" disabled="@isSaving">
                        @(isSaving ? "Saving…" : isEditing ? "Save Changes" : "Create Assignment")
                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }
    [Inject] private IAssignmentService AssignmentService { get; set; } = default!;
    [Inject] private ICourseService CourseService { get; set; } = default!;
    [Inject] private ILogger<Assignments> Logger { get; set; } = default!;
    private List<Assignment> assignments = new();
    private List<Course> courses = new();
    private string searchTerm = "", statusFilter = "All", priorityFilter = "All", sortBy="Due";
    private bool showModal, isEditing, isSaving;
    private int? pendingDeleteId;
    private int editingId;
    private Assignment formModel = new();
    private string errorMessage = "";
    private IEnumerable<Assignment> FilteredAssignments => (sortBy switch { "Priority"=>assignments.OrderByDescending(a=>a.Priority), "Title"=>assignments.OrderBy(a=>a.Title), _=>assignments.OrderBy(a=>a.DueDate) }).Where(a =>
        (string.IsNullOrWhiteSpace(searchTerm) || a.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || a.CourseName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (statusFilter == "All" || a.Status.ToString() == statusFilter) &&
        (priorityFilter == "All" || a.Priority.ToString() == priorityFilter));
    protected override async Task OnInitializedAsync() { AssignmentService.Changed += OnChanged; CourseService.Changed += OnChanged; await LoadAsync(); }
    private async Task LoadAsync() { try { assignments=(await AssignmentService.GetAssignmentsAsync()).ToList(); courses=(await CourseService.GetCoursesAsync()).ToList(); errorMessage=""; } catch (Exception ex) { Logger.LogError(ex,"Assignments could not be loaded."); errorMessage="Assignments could not be loaded. Please try again."; } }
    private void OnChanged() => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    private int CountStatus(string status) => assignments.Count(a => a.Status.ToString() == status.Replace(" ", ""));
    private void OpenCreateModal() { formModel=new Assignment { DueDate=DateTime.Today.AddDays(7), Priority=AssignmentPriority.Medium, Status=AssignmentStatus.Pending }; isEditing=false; showModal=true; }
    private void EditAssignment(Assignment assignment) { editingId=assignment.Id; formModel=new Assignment { Id=assignment.Id,CourseId=assignment.CourseId,CourseName=assignment.CourseName,Title=assignment.Title,Description=assignment.Description,DueDate=assignment.DueDate,Priority=assignment.Priority,Status=assignment.Status,EstimatedMinutes=assignment.EstimatedMinutes }; isEditing=true; showModal=true; }
    private async Task SaveAssignment() { if(isSaving)return; isSaving=true; try { formModel.CourseName=courses.FirstOrDefault(c=>c.Id==formModel.CourseId)?.Code ?? ""; if(isEditing) await AssignmentService.UpdateAssignmentAsync(formModel); else await AssignmentService.CreateAssignmentAsync(formModel); errorMessage=""; await LoadAsync(); CloseModal(); } catch (ValidationException ex) { errorMessage=ex.Message; } catch (Exception ex) { Logger.LogError(ex,"Assignment save failed for {AssignmentId}.",formModel.Id); errorMessage="The assignment could not be saved. Please try again."; } finally { isSaving=false; } }
    private void RequestDeleteAssignment(int id) => pendingDeleteId=id;
    private Task CancelDeleteAssignment() { pendingDeleteId=null; return Task.CompletedTask; }
    private async Task ConfirmDeleteAssignment() { if (pendingDeleteId is not int id) return; try { var deleted=await AssignmentService.DeleteAssignmentAsync(id); pendingDeleteId=null; if(!deleted) errorMessage="This assignment is no longer available."; await LoadAsync(); } catch (Exception ex) { Logger.LogError(ex,"Assignment deletion failed for {AssignmentId}.",id); errorMessage="The assignment could not be deleted."; } }
    private async Task StatusChanged(ChangeEventArgs e, Assignment assignment) { if(Enum.TryParse<AssignmentStatus>(e.Value?.ToString(),out var status)) { assignment.Status=status; await AssignmentService.UpdateAssignmentAsync(assignment); } }
    private void ResetFilters() { searchTerm=""; statusFilter="All"; priorityFilter="All"; sortBy="Due"; }
    private async Task PersistStatus(Assignment assignment){try{if(assignment.Status==AssignmentStatus.Completed&&assignment.CompletedAt is null)assignment.CompletedAt=DateTime.Now;if(assignment.Status!=AssignmentStatus.Completed)assignment.CompletedAt=null;var updated=await AssignmentService.UpdateAssignmentAsync(assignment);if(updated is null){errorMessage="This assignment is no longer available.";await LoadAsync();return;}errorMessage="";}catch(ValidationException ex){errorMessage=ex.Message;await LoadAsync();}catch(Exception ex){Logger.LogError(ex,"Assignment status update failed for {AssignmentId}.",assignment.Id);errorMessage="The assignment status could not be updated.";await LoadAsync();}}
    private void CloseModal() => showModal=false;
    private void HandleModalKeyDown(KeyboardEventArgs e){if(e.Key=="Escape")showModal=false;}
    private string PriorityClass(AssignmentPriority priority) => priority.ToString().ToLowerInvariant();
    private string StatusClass(AssignmentStatus status) => status==AssignmentStatus.InProgress ? "in-progress" : status.ToString().ToLowerInvariant();
    public void Dispose() { AssignmentService.Changed-=OnChanged; CourseService.Changed-=OnChanged; }
}
