@page "/calendar"
@attribute [Authorize]
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@inject ILogger<Calendar> Logger

<PageTitle>Calendar | StudentPlanner</PageTitle>

<div class="calendar-page">

    @if (!string.IsNullOrWhiteSpace(errorMessage)) { <p class="settings-message" role="alert">@errorMessage</p> }

    <!-- HEADER -->
    <div class="calendar-heading">
        <div>
            <span class="page-eyebrow">ACADEMIC WORKSPACE</span>
            <h1>Academic Calendar</h1>
            <p>Manage your classes, exams and assignment deadlines.</p>
        </div>

        <button class="calendar-add-button" @onclick="OpenCreateModal">
            + Add Event
        </button>
    </div>

    <!-- STATISTICS -->
    <div class="calendar-stats">

        <div class="calendar-stat">
            <div class="stat-icon purple-bg">▦</div>
            <div>
                <span>Total Events</span>
                <strong>@events.Count</strong>
            </div>
        </div>

        <div class="calendar-stat">
            <div class="stat-icon blue-bg">▤</div>
            <div>
                <span>Classes</span>
                <strong>@CountType("Class")</strong>
            </div>
        </div>

        <div class="calendar-stat">
            <div class="stat-icon orange-bg">◷</div>
            <div>
                <span>Exams</span>
                <strong>@CountType("Exam")</strong>
            </div>
        </div>

        <div class="calendar-stat">
            <div class="stat-icon green-bg">✓</div>
            <div>
                <span>Assignments</span>
                <strong>@CountType("Assignment")</strong>
            </div>
        </div>

    </div>

    <!-- CALENDAR -->
    <section class="calendar-card">

        <div class="calendar-toolbar">

            <div class="month-navigation">
                <button class="month-arrow"
                        @onclick="PreviousMonth"
                        title="Previous month">
                    ‹
                </button>

                <h2>@DisplayedMonth.ToString("MMMM yyyy")</h2>

                <button class="month-arrow"
                        @onclick="NextMonth"
                        title="Next month">
                    ›
                </button>
            </div>

            <button class="today-button" @onclick="GoToToday">
                Today
            </button>

        </div>

        <!-- LEGEND -->
        <div class="calendar-legend">
            <span><i class="legend-dot class-dot"></i> Classes</span>
            <span><i class="legend-dot exam-dot"></i> Exams</span>
            <span><i class="legend-dot assignment-dot"></i> Assignments</span>
            <span><i class="legend-dot personal-dot"></i> Personal</span>
        </div>

        <!-- WEEKDAYS -->
        <div class="calendar-grid">

            @foreach (var weekday in Weekdays) {
                <div class="weekday">
                    @weekday
                </div>
            }

            <!-- DAYS -->
            @foreach (var day in CalendarDays) {
                var dayEvents = events
                    .Where(e => e.Date.Date == day.Date)
                    .OrderBy(e => e.Time)
                    .ToList();

                <button type="button"
                        @key="day"
                        class="calendar-day
                    @(day.Month != DisplayedMonth.Month ? "other-month" : "")
                    @(day.Date == DateTime.Today ? "today-cell" : "")
                    @(day.Date == selectedDate.Date ? "selected-day" : "")"
                        @onclick="() => SelectDate(day)">

                    <span class="day-number">
                        @day.Day
                    </span>

                    <div class="day-events">

                        @foreach (var item in dayEvents.Take(3)) {
                            <span class="calendar-event @EventTypeClass(item.Type)"
                                  title="@item.Title">
                                @item.Title
                            </span>
                        }

                        @if (dayEvents.Count > 3) {
                            <span class="more-events">
                                +@(dayEvents.Count - 3) more
                            </span>
                        }

                    </div>

                </button>
            }

        </div>

    </section>

    <!-- SELECTED DAY EVENTS -->
    <section class="selected-events-card">

        <div class="selected-events-heading">
            <div>
                <span class="page-eyebrow">DAILY SCHEDULE</span>
                <h2>@selectedDate.ToString("dddd, MMMM dd, yyyy")</h2>
                <p>Your scheduled academic activities</p>
            </div>

            <button class="small-add-button"
                    @onclick="() => OpenCreateModal()">
                + Add Event
            </button>
        </div>

        @if (!EventsForSelectedDate.Any()) {
            <div class="no-events">
                <span>▦</span>
                <h3>No events scheduled</h3>
                <p>You have no activities planned for this day.</p>

                <button class="small-add-button"
                        @onclick="OpenCreateModal">
                    Create an event
                </button>
            </div>
        } else {
            <div class="event-list">

                @foreach (var item in EventsForSelectedDate) {
                    <div class="event-row" @key="item.Id">

                        <div class="event-time">
                            <strong>@item.Time</strong>
                            <span>@item.Type</span>
                        </div>

                        <div class="event-color-bar @EventTypeClass(item.Type)"></div>

                        <div class="event-information">
                            <strong>@item.Title</strong>
                            <span>@item.CourseName</span>

                            @if (!string.IsNullOrWhiteSpace(item.Description)) {
                                <p>@item.Description</p>
                            }
                        </div>

                        <div class="event-actions">

                            <button class="event-action edit-event"
                                    title="Edit event"
                                    @onclick="() => EditEvent(item)">
                                ✎
                            </button>

                            <button class="event-action delete-event"
                                    title="Delete event"
                                    aria-label="Delete event @item.Title"
                                    @onclick="() => RequestDeleteEvent(item.Id)">
                                🗑
                            </button>

                        </div>

                    </div>
                }

            </div>
        }

    </section>

</div>

<section class="selected-events-card">
    <div class="selected-events-heading"><div><span class="page-eyebrow">ASSIGNMENT DEADLINES</span><h2>Upcoming work</h2><p>Deadlines come from your shared assignments.</p></div></div>
    @if (!assignments.Any(a => a.Status != AssignmentStatus.Completed && a.DueDate.Date >= DateTime.Today)) { <div class="no-events"><h3>No upcoming assignment deadlines</h3></div> } else {
        <div class="event-list">@foreach (var assignment in assignments.Where(a => a.Status != AssignmentStatus.Completed && a.DueDate.Date >= DateTime.Today).OrderBy(a => a.DueDate).Take(5)) { <div class="event-row"><div class="event-time"><strong>@assignment.DueDate.ToString("MMM dd")</strong><span>@assignment.Priority</span></div><div class="event-color-bar assignment"></div><div class="event-information"><strong>@assignment.Title</strong><span>@assignment.CourseName</span></div></div> }</div>
    }
</section>

@if (pendingDeleteId is not null) {
    <ConfirmDialog Title="Delete this event?" Message="This action cannot be undone."
                   ConfirmText="Delete event" OnConfirm="ConfirmDeleteEvent" OnCancel="CancelDeleteEvent" />
}

<!-- CREATE / EDIT MODAL -->
@if (showModal) {
    <div class="calendar-modal-overlay" @onclick="CloseModal" @onkeydown="HandleModalKeyDown">

        <div class="calendar-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" tabindex="-1">

            <div class="modal-header">

                <div>
                    <span class="page-eyebrow">EVENT MANAGEMENT</span>

                    <h2>
                        @(isEditing ? "Edit Event" : "Create Event")
                    </h2>

                    <p>Enter the details of your academic event.</p>
                </div>

                <button class="calendar-modal-close"
                        @onclick="CloseModal" @onkeydown="HandleModalKeyDown">
                    ×
                </button>

            </div>

            <EditForm Model="formModel" OnValidSubmit="SaveEvent" class="planner-form">

                <DataAnnotationsValidator />
                @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="calendar-form-error" role="alert">@errorMessage</div> }

                <div class="calendar-form-group">
                    <label>Event Title *</label>

                    <InputText class="calendar-input"
                               @bind-Value="formModel.Title"
                               placeholder="e.g. Database Management Exam" />

                    <ValidationMessage For="@(() => formModel.Title)" />
                </div>

                <div class="calendar-form-group">
                    <label>Course / Subject *</label>

                    <InputSelect class="calendar-input" @bind-Value="formModel.CourseId">
                        <option value="">Personal / no course</option>
                        @foreach (var course in courses) { <option value="@course.Id">@course.Code — @course.Name</option> }
                    </InputSelect>
                </div>

                <div class="calendar-form-row">

                    <div class="calendar-form-group">
                        <label>Date *</label>

                        <InputDate class="calendar-input"
                                   @bind-Value="formModel.Date" />
                    </div>

                    <div class="calendar-form-group">
                        <label>Time</label>

                        <InputDate class="calendar-input" Type="InputDateType.Time" @bind-Value="formModel.StartTime" />
                    </div>

                    <div class="calendar-form-group">
                        <label>End Time</label>
                        <InputDate class="calendar-input" Type="InputDateType.Time" @bind-Value="formModel.EndTime" />
                    </div>

                </div>

                <div class="calendar-form-group">
                    <label>Event Type</label>

                    <InputSelect class="calendar-input"
                                 @bind-Value="formModel.Type">

                        <option value="Class">Class</option>
                        <option value="Exam">Exam</option>
                        <option value="Assignment">Assignment</option>
                        <option value="Personal">Personal</option>

                    </InputSelect>
                </div>

                <div class="calendar-form-group">
                    <label>Description</label>

                    <InputTextArea class="calendar-input calendar-textarea"
                                   @bind-Value="formModel.Description"
                                   placeholder="Additional information..." />
                </div>

                <div class="calendar-modal-actions">

                    <button type="button"
                            class="calendar-cancel-button"
                            @onclick="CloseModal" @onkeydown="HandleModalKeyDown">
                        Cancel
                    </button>

                    <button type="submit" class="calendar-add-button" disabled="@isSaving">
                        @(isSaving ? "Saving…" : isEditing ? "Save Changes" : "Create Event")
                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}

@code {
    [Inject] private IScheduleService ScheduleService { get; set; } = default!;
    [Inject] private ICourseService CourseService { get; set; } = default!;
    [Inject] private IAssignmentService AssignmentService { get; set; } = default!;
    private List<ScheduleEvent> events=new(); private List<Course> courses=new(); private List<Assignment> assignments=new();
    private DateTime DisplayedMonth=new(DateTime.Today.Year,DateTime.Today.Month,1),selectedDate=DateTime.Today;
    private bool showModal,isEditing,isSaving; private int editingId; private int? pendingDeleteId; private ScheduleEvent formModel=new(); private string errorMessage="";
    private readonly string[] Weekdays={"MON","TUE","WED","THU","FRI","SAT","SUN"};
    private IEnumerable<DateTime> CalendarDays { get { var first=DisplayedMonth;var offset=((int)first.DayOfWeek+6)%7;var start=first.AddDays(-offset);return Enumerable.Range(0,42).Select(i=>start.AddDays(i)); } }
    private IEnumerable<ScheduleEvent> EventsForSelectedDate=>events.Where(e=>e.StartTime.Date==selectedDate.Date).OrderBy(e=>e.StartTime);
    protected override async Task OnInitializedAsync(){ScheduleService.Changed+=OnChanged;CourseService.Changed+=OnChanged;AssignmentService.Changed+=OnChanged;await LoadAsync();}
    private async Task LoadAsync(){try{events=(await ScheduleService.GetEventsAsync()).ToList();courses=(await CourseService.GetCoursesAsync()).ToList();assignments=(await AssignmentService.GetAssignmentsAsync()).ToList();errorMessage="";}catch(Exception ex){Logger.LogError(ex,"Calendar data could not be loaded.");errorMessage="Calendar data could not be loaded.";}}
    private void OnChanged()=>_ = InvokeAsync(async()=>{await LoadAsync();StateHasChanged();});
    private int CountType(string type)=>events.Count(e=>e.Type.ToString()==type);
    private void PreviousMonth()=>DisplayedMonth=DisplayedMonth.AddMonths(-1);
    private void NextMonth()=>DisplayedMonth=DisplayedMonth.AddMonths(1);
    private void GoToToday(){DisplayedMonth=new(DateTime.Today.Year,DateTime.Today.Month,1);selectedDate=DateTime.Today;}
    private void SelectDate(DateTime day){selectedDate=day.Date;if(day.Month!=DisplayedMonth.Month||day.Year!=DisplayedMonth.Year)DisplayedMonth=new(day.Year,day.Month,1);}
    private void OpenCreateModal(){var start=FindNextAvailableStart(selectedDate.Date);formModel=new ScheduleEvent{StartTime=start,EndTime=start.AddHours(1),Type=ScheduleEventType.Class};isEditing=false;showModal=true;}
    private DateTime FindNextAvailableStart(DateTime date){var start=date.Date.AddHours(9);while(start<date.Date.AddHours(23)&&events.Any(item=>item.StartTime<start.AddHours(1)&&item.EndTime>start))start=start.AddHours(1);return start;}
    private void EditEvent(ScheduleEvent item){editingId=item.Id;formModel=new ScheduleEvent{Id=item.Id,CourseId=item.CourseId,CourseName=item.CourseName,Title=item.Title,Description=item.Description,StartTime=item.StartTime,EndTime=item.EndTime,Location=item.Location,Type=item.Type};isEditing=true;showModal=true;}
    private async Task SaveEvent(){if(isSaving)return;if(formModel.EndTime<=formModel.StartTime){errorMessage="End time must be later than start time.";return;}isSaving=true;try{formModel.CourseName=courses.FirstOrDefault(c=>c.Id==formModel.CourseId)?.Code??"Personal";if(isEditing)await ScheduleService.UpdateEventAsync(formModel);else await ScheduleService.CreateEventAsync(formModel);errorMessage="";selectedDate=formModel.StartTime.Date;DisplayedMonth=new(selectedDate.Year,selectedDate.Month,1);await LoadAsync();CloseModal();}catch(ValidationException ex){errorMessage=ex.Message;}catch(Exception ex){Logger.LogError(ex,"Calendar event save failed for {EventId}.",formModel.Id);errorMessage="The event could not be saved. Please try again.";}finally{isSaving=false;}}
    private void RequestDeleteEvent(int id)=>pendingDeleteId=id;
    private Task CancelDeleteEvent(){pendingDeleteId=null;return Task.CompletedTask;}
    private async Task ConfirmDeleteEvent(){if(pendingDeleteId is not int id)return;try{var deleted=await ScheduleService.DeleteEventAsync(id);pendingDeleteId=null;if(!deleted)errorMessage="This event is no longer available.";await LoadAsync();}catch(Exception ex){Logger.LogError(ex,"Calendar event deletion failed for {EventId}.",id);errorMessage="The event could not be deleted.";}}
    private void CloseModal()=>showModal=false;
    private void HandleModalKeyDown(KeyboardEventArgs e){if(e.Key=="Escape")showModal=false;}
    private string EventTypeClass(ScheduleEventType type)=>type.ToString().ToLowerInvariant();
    public void Dispose(){ScheduleService.Changed-=OnChanged;CourseService.Changed-=OnChanged;AssignmentService.Changed-=OnChanged;}
}
