@page "/courses"
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@inject ILogger<Courses> Logger

<PageTitle>Courses | StudentPlanner</PageTitle>

<div class="courses-page">

    <div class="courses-heading">
        <div>
            <span class="courses-eyebrow">ACADEMIC WORKSPACE</span>
            <h1>My Courses</h1>
            <p>Manage your subjects, instructors and class schedules.</p>
        </div>

        <button class="course-primary-button" @onclick="OpenCreateModal">
            + Add Course
        </button>
    </div>

    <!-- STATISTICS -->

    <div class="courses-stats">

        <div class="course-stat-card">
            <div class="course-stat-icon purple">▦</div>
            <div>
                <span>Total Courses</span>
                <strong>@courses.Count</strong>
            </div>
        </div>

        <div class="course-stat-card">
            <div class="course-stat-icon blue">◷</div>
            <div>
                <span>Total Credits</span>
                <strong>@courses.Sum(c => c.Credits)</strong>
            </div>
        </div>

        <div class="course-stat-card">
            <div class="course-stat-icon green">✓</div>
            <div>
                <span>Active Courses</span>
                <strong>@courses.Count(c => c.IsActive)</strong>
            </div>
        </div>

        <div class="course-stat-card">
            <div class="course-stat-icon orange">▤</div>
            <div>
                <span>Instructors</span>
                <strong>@courses.Select(c => c.Instructor).Distinct().Count()</strong>
            </div>
        </div>

    </div>

    <!-- SEARCH AND FILTER -->

    <section class="courses-content">

        <div class="courses-content-header">
            <div>
                <h2>All Courses</h2>
                <p>View and manage your academic subjects.</p>
            </div>

            <span class="courses-results">@FilteredCourses.Count() results</span>
        </div>

        <div class="courses-toolbar">

            <div class="course-search">
                <span>⌕</span>
                <input type="text"
                       placeholder="Search courses..."
                       @bind="searchTerm"
                       @bind:event="oninput" />
            </div>

            <select class="course-filter" @bind="statusFilter">
                <option value="All">All Courses</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>

            <select class="course-filter" @bind="sortBy" aria-label="Sort courses"><option value="Name">Sort by name</option><option value="Code">Sort by code</option><option value="Credits">Sort by credits</option></select>
            <button class="course-reset-button" @onclick="ResetFilters">
                Reset
            </button>

        </div>

        <!-- COURSE CARDS -->
        @if (!FilteredCourses.Any()) {
            <div class="courses-empty">
                <span>▦</span>
                <h3>No courses found</h3>
                <p>Try changing your search or add a new course.</p>
                <button class="course-primary-button"
                        @onclick="OpenCreateModal">
                    + Add Course
                </button>
            </div>
        } else {
            <div class="courses-grid">

                @foreach (var course in FilteredCourses) {
                    <article class="course-card" @key="course.Id">

                        <div class="course-card-top">

                            <div class="course-color-icon @course.Color">
                                @course.Code.Substring(0, Math.Min(2, course.Code.Length))
                            </div>

                            <div class="course-card-actions">
                                <button title="Edit"
                                        @onclick="() => EditCourse(course)">
                                    ✎
                                </button>

                                <button title="Delete"
                                        @onclick="() => RequestDeleteCourse(course.Id)">
                                    🗑
                                </button>
                            </div>

                        </div>

                        <div class="course-card-info">
                            <span class="course-code">@course.Code</span>

                            <h3>@course.Name</h3>

                            <p class="course-instructor">
                                <span>◉</span> @course.Instructor
                            </p>
                        </div>

                        <div class="course-details">

                            <div>
                                <span>ROOM</span>
                                <strong>@course.Room</strong>
                            </div>

                            <div>
                                <span>CREDITS</span>
                                <strong>@course.Credits</strong>
                            </div>

                            <div>
                                <span>STATUS</span>
                                <strong class="@(course.IsActive ? "active-text" : "inactive-text")">
                                    @(course.IsActive ? "Active" : "Inactive")
                                </strong>
                            </div>

                        </div>

                        <div class="course-schedule">
                            <span class="schedule-label">CLASS SCHEDULE</span>
                            <strong>@course.Schedule</strong>
                        </div>

                        <div class="course-card-footer">

                            <button class="course-details-button"
                                    @onclick="() => ViewCourse(course)">
                                View Details →
                            </button>

                            <button class="course-status-button"
                                    @onclick="() => ToggleCourseStatus(course)">
                                @(course.IsActive ? "Deactivate" : "Activate")
                            </button>

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>

@if (!string.IsNullOrWhiteSpace(errorMessage)) { <p class="settings-message" role="alert">@errorMessage</p> }
@if (pendingDeleteId is not null) { <ConfirmDialog Title="Delete this course?" Message="Courses with grades or assignments cannot be deleted." ConfirmText="Delete course" OnConfirm="ConfirmDeleteCourse" OnCancel="CancelDeleteCourse" /> }
<!-- CREATE / EDIT MODAL -->
@if (showModal) {
    <div class="course-modal-overlay" @onclick="CloseModal" @onkeydown="HandleModalKeyDown">

        <div class="course-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" tabindex="-1">

            <div class="course-modal-header">

                <div>
                    <span class="courses-eyebrow">COURSE MANAGEMENT</span>
                    <h2>@(isEditing ? "Edit Course" : "Add New Course")</h2>
                    <p>Enter your subject information below.</p>
                </div>

                <button class="course-close-button" @onclick="CloseModal" @onkeydown="HandleModalKeyDown">
                    ×
                </button>

            </div>

            <EditForm Model="formModel" OnValidSubmit="SaveCourse" class="planner-form">

                <DataAnnotationsValidator />
                @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="course-form-error" role="alert">@errorMessage</div> }

                <div class="course-form-group">
                    <label>Course Name *</label>
                    <InputText class="course-input"
                               @bind-Value="formModel.Name"
                               placeholder="e.g. Database Management Systems" />
                    <ValidationMessage For="@(() => formModel.Name)" />
                </div>

                <div class="course-form-row">

                    <div class="course-form-group">
                        <label>Course Code *</label>
                        <InputText class="course-input"
                                   @bind-Value="formModel.Code"
                                   placeholder="e.g. DBMS" />
                        <ValidationMessage For="@(() => formModel.Code)" />
                    </div>

                    <div class="course-form-group">
                        <label>Credits *</label>
                        <InputNumber class="course-input"
                                     @bind-Value="formModel.Credits" />
                        <ValidationMessage For="@(() => formModel.Credits)" />
                    </div>

                </div>

                <div class="course-form-group">
                    <label>Instructor *</label>
                    <InputText class="course-input"
                               @bind-Value="formModel.Instructor"
                               placeholder="e.g. John Smith" />
                    <ValidationMessage For="@(() => formModel.Instructor)" />
                </div>

                <div class="course-form-row">

                    <div class="course-form-group">
                        <label>Classroom</label>
                        <InputText class="course-input"
                                   @bind-Value="formModel.Room"
                                   placeholder="e.g. C1.2.301" />
                    </div>

                    <div class="course-form-group">
                        <label>Schedule</label>
                        <InputText class="course-input"
                                   @bind-Value="formModel.Schedule"
                                   placeholder="e.g. Mon, 10:00" />
                    </div>

                </div>

                <div class="course-form-row">

                    <div class="course-form-group">
                        <label>Color</label>
                        <InputSelect class="course-input"
                                     @bind-Value="formModel.Color">
                            <option value="purple">Purple</option>
                            <option value="blue">Blue</option>
                            <option value="green">Green</option>
                            <option value="orange">Orange</option>
                            <option value="pink">Pink</option>
                        </InputSelect>
                    </div>

                    <div class="course-form-group">
                        <label>Status</label>
                        <InputSelect class="course-input"
                                     @bind-Value="formModel.IsActive">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </InputSelect>
                    </div>

                </div>

                <div class="course-form-group">
                    <label>Description</label>
                    <InputTextArea class="course-input course-textarea"
                                   @bind-Value="formModel.Description"
                                   placeholder="Course description..." />
                </div>

                <div class="course-modal-actions">

                    <button type="button"
                            class="course-cancel-button"
                            @onclick="CloseModal" @onkeydown="HandleModalKeyDown">
                        Cancel
                    </button>

                    <button type="submit" class="course-primary-button" disabled="@isSaving">
                        @(isSaving ? "Saving…" : isEditing ? "Save Changes" : "Create Course")
                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}

<!-- COURSE DETAILS MODAL -->
@if (selectedCourse != null) {
    <div class="course-modal-overlay" @onclick="CloseDetails" @onkeydown="HandleModalKeyDown">

        <div class="course-modal details-modal"
             @onclick:stopPropagation="true" role="dialog" aria-modal="true" tabindex="-1">

            <div class="course-modal-header">

                <div>
                    <span class="courses-eyebrow">COURSE OVERVIEW</span>
                    <h2>@selectedCourse.Name</h2>
                    <p>@selectedCourse.Code</p>
                </div>

                <button class="course-close-button" @onclick="CloseDetails" @onkeydown="HandleModalKeyDown">
                    ×
                </button>

            </div>

            <div class="course-detail-list">

                <div>
                    <span>Instructor</span>
                    <strong>@selectedCourse.Instructor</strong>
                </div>

                <div>
                    <span>Classroom</span>
                    <strong>@selectedCourse.Room</strong>
                </div>

                <div>
                    <span>Credits</span>
                    <strong>@selectedCourse.Credits</strong>
                </div>

                <div>
                    <span>Schedule</span>
                    <strong>@selectedCourse.Schedule</strong>
                </div>

                <div>
                    <span>Status</span>
                    <strong>@(selectedCourse.IsActive ? "Active" : "Inactive")</strong>
                </div>

                <div>
                    <span>Description</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(selectedCourse.Description)
                            ? "No description available."
                            : selectedCourse.Description)
                    </strong>
                </div>

            </div>

            <div class="course-modal-actions">
                <button class="course-cancel-button"
                        @onclick="CloseDetails" @onkeydown="HandleModalKeyDown">
                    Close
                </button>

                <button class="course-primary-button"
                        @onclick="() => EditCourse(selectedCourse)">
                    Edit Course
                </button>
            </div>

        </div>

    </div>
}

@code {
    [Inject] private ICourseService CourseService { get; set; } = default!;
    [Inject] private IAssignmentService AssignmentService { get; set; } = default!;
    [Inject] private IGradeService GradeService { get; set; } = default!;
    private List<Course> courses=new();
    private string searchTerm="", statusFilter="All", errorMessage="", sortBy="Name";
    private bool showModal,isEditing,isSaving;
    private int editingId; private int? pendingDeleteId;
    private Course formModel=new();
    private Course? selectedCourse;
    private IEnumerable<Course> FilteredCourses => (sortBy switch { "Code"=>courses.OrderBy(c=>c.Code), "Credits"=>courses.OrderByDescending(c=>c.Credits), _=>courses.OrderBy(c=>c.Name) }).Where(c =>
        (string.IsNullOrWhiteSpace(searchTerm) || c.Name.Contains(searchTerm,StringComparison.OrdinalIgnoreCase) || c.Code.Contains(searchTerm,StringComparison.OrdinalIgnoreCase) || c.Instructor.Contains(searchTerm,StringComparison.OrdinalIgnoreCase)) &&
        (statusFilter=="All" || (statusFilter=="Active"&&c.IsActive) || (statusFilter=="Inactive"&&!c.IsActive)));
    protected override async Task OnInitializedAsync(){CourseService.Changed+=OnChanged;await LoadAsync();}
    private async Task LoadAsync(){try{courses=(await CourseService.GetCoursesAsync()).ToList();errorMessage="";}catch(Exception ex){Logger.LogError(ex,"Courses could not be loaded.");errorMessage="Courses could not be loaded. Please try again.";}}
    private void OnChanged()=>_ = InvokeAsync(async()=>{await LoadAsync();StateHasChanged();});
    private void OpenCreateModal(){formModel=new Course();isEditing=false;showModal=true;}
    private void EditCourse(Course course){editingId=course.Id;formModel=new Course{Id=course.Id,Name=course.Name,Code=course.Code,Instructor=course.Instructor,Credits=course.Credits,Room=course.Room,Schedule=course.Schedule,Color=course.Color,IsActive=course.IsActive,Description=course.Description};selectedCourse=null;isEditing=true;showModal=true;}
    private async Task SaveCourse(){if(isSaving)return;isSaving=true;try{if(isEditing)await CourseService.UpdateCourseAsync(formModel);else await CourseService.CreateCourseAsync(formModel);errorMessage="";await LoadAsync();CloseModal();}catch(ValidationException ex){errorMessage=ex.Message;}catch(Exception ex){Logger.LogError(ex,"Course save failed for {CourseId}.",formModel.Id);errorMessage="The course could not be saved. Please try again.";}finally{isSaving=false;}}
    private void RequestDeleteCourse(int id)=>pendingDeleteId=id;
    private Task CancelDeleteCourse(){pendingDeleteId=null;return Task.CompletedTask;}
    private async Task ConfirmDeleteCourse(){
        if(pendingDeleteId is not int id)return;
        var assignments=await AssignmentService.GetAssignmentsAsync(); var grades=await GradeService.GetGradesAsync();
        if(assignments.Any(a=>a.CourseId==id)||grades.Any(g=>g.CourseId==id)){errorMessage="This course still has assignments or grades. Reassign or remove them before deleting the course.";pendingDeleteId=null;return;}
        try{await CourseService.DeleteCourseAsync(id);pendingDeleteId=null;await LoadAsync();if(selectedCourse?.Id==id)selectedCourse=null;}catch(Exception ex){Logger.LogError(ex,"Course deletion failed for {CourseId}.",id);errorMessage="The course could not be deleted.";}
    }
    private void ViewCourse(Course course)=>selectedCourse=course;
    private void CloseDetails()=>selectedCourse=null;
    private async Task ToggleCourseStatus(Course course){var wasActive=course.IsActive;course.IsActive=!wasActive;try{var updated=await CourseService.UpdateCourseAsync(course);if(updated is null){course.IsActive=wasActive;errorMessage="This course is no longer available.";}}catch(Exception ex){course.IsActive=wasActive;Logger.LogError(ex,"Course status update failed for {CourseId}.",course.Id);errorMessage="The course status could not be updated.";await LoadAsync();}}
    private void ResetFilters(){searchTerm="";statusFilter="All";sortBy="Name";}
    private void CloseModal()=>showModal=false;
    private void HandleModalKeyDown(KeyboardEventArgs e){if(e.Key=="Escape"){showModal=false;selectedCourse=null;pendingDeleteId=null;}}
    public void Dispose()=>CourseService.Changed-=OnChanged;
}
