@page "/grades"
@using System.ComponentModel.DataAnnotations
@using GradeModel = StudentPlanner.Models.Grade
@inject IUserPreferencesService Preferences
@inject IGradeService GradeService

<PageTitle>Grades & Analytics | StudentPlanner</PageTitle>
@if (!string.IsNullOrWhiteSpace(errorMessage)) {
    <ErrorBanner Message="@errorMessage" />
}

<div class="grades-page">

    <!-- HEADER -->

    <div class="grades-heading">
        <div>
            <span class="grades-eyebrow">ACADEMIC PERFORMANCE</span>
            <h1>Grades & Analytics</h1>
            <p>Track your academic progress and monitor your GPA.</p>
        </div>

        <button class="grades-primary-button" @onclick="OpenCreateModal">
            + Add Grade
        </button>
    </div>

    <!-- STATISTICS -->

    <div class="grades-stats">

        <div class="grade-stat-card">
            <div class="grade-stat-icon purple">★</div>
            <div>
                <span>Current GPA</span>
                <strong>@CurrentGPA.ToString("0.00") <small>/ @ScaleLimit.ToString("0.##")</small></strong>
            </div>
        </div>

        <div class="grade-stat-card">
            <div class="grade-stat-icon blue">▤</div>
            <div>
                <span>Recorded Grades</span>
                <strong>@grades.Count</strong>
            </div>
        </div>

        <div class="grade-stat-card">
            <div class="grade-stat-icon green">✓</div>
            <div>
                <span>Average Score</span>
                <strong>@AverageScore.ToString("0.0")%</strong>
            </div>
        </div>

        <div class="grade-stat-card">
            <div class="grade-stat-icon orange">◆</div>
            <div>
                <span>Highest Score</span>
                <strong>@(grades.Any() ? $"{grades.Max(g => g.Score):0}%" : "0%")</strong>
            </div>
        </div>

    </div>

    <!-- GPA OVERVIEW -->

    <div class="grades-overview-grid">

        <section class="gpa-card">

            <div class="grades-section-heading">
                <div>
                    <h2>GPA Overview</h2>
                    <p>Your overall academic performance</p>
                </div>
            </div>

            <div class="gpa-visual">

                <div class="gpa-circle"
                     style="@($"background: conic-gradient(#7167ed 0% {GpaPercentage}%, var(--border) {GpaPercentage}% 100%)")">

                    <div class="gpa-circle-inner">
                        <strong>@CurrentGPA.ToString("0.00")</strong>
                        <span>OUT OF 4.00</span>
                    </div>

                </div>

                <div class="gpa-description">
                    <strong>@PerformanceLabel</strong>
                    <span>@PerformanceDescription</span>
                </div>

            </div>

            <div class="gpa-details">

                <div>
                    <span>Academic Target</span>
                    <strong>@ScaleLimit.ToString("0.##") GPA</strong>
                </div>

                <div>
                    <span>Current Performance</span>
                    <strong>@GpaPercentage.ToString("0.0")%</strong>
                </div>

                <div>
                    <span>Total Credits</span>
                    <strong>@TotalCredits</strong>
                </div>

            </div>

        </section>

        <!-- GRADE DISTRIBUTION -->

        <section class="distribution-card">

            <div class="grades-section-heading">
                <div>
                    <h2>Grade Distribution</h2>
                    <p>Breakdown of your academic results</p>
                </div>
            </div>

            @foreach (var item in Distribution) {
                <div class="distribution-row">

                    <div class="distribution-label">
                        <strong>@item.Label</strong>
                        <span>@item.Count grades</span>
                    </div>

                    <div class="distribution-track">
                        <div class="distribution-fill @item.CssClass"
                             style="@($"width: {item.Percentage}%")">
                        </div>
                    </div>

                    <strong class="distribution-percentage">
                        @item.Percentage.ToString("0")%
                    </strong>

                </div>
            }

            @if (!grades.Any()) {
                <div class="grades-empty-small">
                    No grades available yet.
                </div>
            }

        </section>

    </div>

    <!-- PERFORMANCE CHART -->

    <section class="performance-card">

        <div class="grades-section-heading">
            <div>
                <h2>Academic Performance</h2>
                <p>Compare your scores across different subjects.</p>
            </div>
        </div>

        @if (grades.Any()) {
            <div class="performance-chart">

                @foreach (var grade in grades.OrderBy(g => g.Course)) {
                    <div class="chart-column">

                        <span class="chart-value">
                            @grade.Score.ToString("0")%
                        </span>

                        <div class="chart-bar-area">
                            <div class="chart-bar"
                                 style="@($"height: {grade.Score}%")">
                            </div>
                        </div>

                        <span class="chart-label" title="@grade.Course">
                            @grade.Course
                        </span>

                    </div>
                }

            </div>

            <div class="chart-axis">
                <span>0%</span>
                <span>25%</span>
                <span>50%</span>
                <span>75%</span>
                <span>100%</span>
            </div>
        } else {
            <div class="grades-empty-small">
                Add grades to see your performance chart.
            </div>
        }

    </section>

    <!-- GRADES TABLE -->

    <section class="grades-table-card">

        <div class="grades-table-heading">
            <div>
                <h2>My Grades</h2>
                <p>Manage your academic results.</p>
            </div>

            <span class="grades-results">
                @FilteredGrades.Count() results
            </span>
        </div>

        <!-- FILTERS -->

        <div class="grades-toolbar">

            <div class="grades-search">
                <span>⌕</span>

                <input type="text"
                       placeholder="Search by course or assessment..." aria-label="Search grades"
                       @bind="searchTerm"
                       @bind:event="oninput" />
            </div>

            <select class="grades-filter" aria-label="Filter grades by letter" @bind="letterFilter">
                <option value="All">All Grades</option>
                <option value="A">A / A-</option>
                <option value="B">B / B+ / B-</option>
                <option value="C">C / C+ / C-</option>
                <option value="D">D</option>
                <option value="F">F</option>
            </select>
            <select class="grades-filter" aria-label="Sort grades" @bind="sortBy"><option value="date">Sort: date</option><option value="course">Sort: course</option></select>

            <button class="grades-reset-button" @onclick="ResetFilters">
                Reset
            </button>

        </div>

        <!-- TABLE -->
        @if (!FilteredGrades.Any()) {
            <div class="grades-empty">
                <span>▤</span>
                <h3>No grades found</h3>
                <p>Try changing your filters or add a new grade.</p>
            </div>
        } else {
            <div class="grades-table-wrapper">

                <table class="grades-table">

                    <thead>
                        <tr>
                            <th>COURSE</th>
                            <th>ASSESSMENT</th>
                            <th>SCORE</th>
                            <th>LETTER</th>
                            <th>GPA POINT</th>
                            <th>CREDITS</th>
                            <th>DATE</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var grade in FilteredGrades) {
                            <tr @key="grade.Id">

                                <td>
                                    <strong>@grade.Course</strong>
                                </td>

                                <td>
                                    <span class="assessment-name">
                                        @grade.Assessment
                                    </span>
                                </td>

                                <td>
                                    <div class="score-cell">
                                        <strong>@grade.Score.ToString("0")%</strong>
                                        <div class="score-track">
                                            <div class="score-fill"
                                                 style="@($"width: {grade.Score}%")">
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="grade-letter @GradeClass(grade.Score)">
                                        @GetLetter(grade.Score)
                                    </span>
                                </td>

                                <td>
                                    <strong>@GetGradePoint(grade.Score).ToString("0.00")</strong>
                                </td>

                                <td>@grade.Credits</td>

                                <td>@grade.Date.ToString("dd MMM yyyy")</td>

                                <td>
                                    <div class="grade-actions">

                                        <button aria-label="Edit grade" title="Edit grade"
                                                @onclick="() => EditGrade(grade)">
                                            ✎
                                        </button>

                                        <ConfirmActionButton CssClass="grade-delete-action" AriaLabel="Delete grade" ConfirmationMessage="Delete this grade?" OnConfirmed="() => DeleteGrade(grade.Id)">🗑</ConfirmActionButton>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <div class="grades-table-footer">
            Showing @FilteredGrades.Count() of @grades.Count grades
        </div>

    </section>

</div>

<!-- ADD / EDIT MODAL -->
@if (showModal) {
    <div class="grades-modal-overlay" @onclick="CloseModal">

        <div class="grades-modal" role="dialog" aria-modal="true" aria-labelledby="grade-dialog-title" tabindex="-1" @onkeydown="HandleModalKeyDown" @onclick:stopPropagation="true">

            <div class="grades-modal-header">

                <div>
                    <span class="grades-eyebrow">GRADE MANAGEMENT</span>
                    <h2>@(isEditing ? "Edit Grade" : "Add New Grade")</h2>
                    <p>Enter your academic assessment results.</p>
                </div>

                <button class="grades-close-button" aria-label="Close grade form" @onclick="CloseModal">
                    ×
                </button>

            </div>

            <EditForm Model="formModel" OnValidSubmit="SaveGrade">

                <DataAnnotationsValidator />

                <div class="grades-form-group">
                    <label>Course Name *</label>

                    <InputText class="grades-input"
                               @bind-Value="formModel.Course"
                               placeholder="e.g. Database Management" />

                    <ValidationMessage For="@(() => formModel.Course)" />
                </div>

                <div class="grades-form-group">
                    <label>Assessment *</label>

                    <InputText class="grades-input"
                               @bind-Value="formModel.Assessment"
                               placeholder="e.g. Midterm Exam" />

                    <ValidationMessage For="@(() => formModel.Assessment)" />
                </div>

                <div class="grades-form-row">

                    <div class="grades-form-group">
                        <label>Score (%) *</label>

                        <InputNumber class="grades-input"
                                     @bind-Value="formModel.Score"
                                     step="0.5" />

                        <ValidationMessage For="@(() => formModel.Score)" />
                    </div>

                    <div class="grades-form-group">
                        <label>Credits *</label>

                        <InputNumber class="grades-input"
                                     @bind-Value="formModel.Credits" />

                        <ValidationMessage For="@(() => formModel.Credits)" />
                    </div>

                </div>

                <div class="grades-form-group">
                    <label>Date *</label>

                    <InputDate class="grades-input"
                               @bind-Value="formModel.Date" />
                </div>

                <div class="grades-preview">
                    <span>Calculated Grade</span>

                    <strong class="@GradeClass(formModel.Score)">
                        @GetLetter(formModel.Score)
                    </strong>

                    <span>
                        @GetGradePoint(formModel.Score).ToString("0.00") GPA
                    </span>
                </div>

                <div class="grades-modal-actions">

                    <button type="button"
                            class="grades-cancel-button"
                            @onclick="CloseModal">
                        Cancel
                    </button>

                    <button type="submit" class="grades-primary-button">
                        @(isEditing ? "Save Changes" : "Add Grade")
                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}

@code {

    private List<GradeModel> grades = [];
    private string errorMessage = "";

    protected override async Task OnInitializedAsync() {
        try { grades = await GradeService.GetAllAsync(); }
        catch (Exception ex) { errorMessage = $"Could not load grades: {ex.Message}"; }
    }

    // DISTRIBUTION MODEL

    private class DistributionItem {
        public string Label { get; set; } = "";
        public string CssClass { get; set; } = "";
        public int Count { get; set; }
        public decimal Percentage { get; set; }
    }

    // STATE

    private string searchTerm = "";
    private string letterFilter = "All";
    private string sortBy = "date";

    private bool showModal = false;
    private bool isEditing = false;

    private int editingId;

    private GradeModel formModel = new();

    // FILTERING

    private IEnumerable<GradeModel> FilteredGrades =>
        grades.Where(g =>
            (string.IsNullOrWhiteSpace(searchTerm) ||
             g.Course.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             g.Assessment.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            &&
            (letterFilter == "All" ||
             GetLetter(g.Score).StartsWith(letterFilter,
                 StringComparison.OrdinalIgnoreCase))
        ).OrderBy(g => sortBy == "course" ? g.Course : g.Date.ToString("yyyy-MM-dd"));

    // GPA CALCULATION
    // Weighted by course credits.

    private decimal ScaleLimit => Preferences.Current.GpaScale == "100" ? 100m : decimal.TryParse(Preferences.Current.GpaScale, out var scale) ? scale : 4m;
    private decimal NormalizedGpa => ScaleLimit == 0 ? 0 : CurrentGPA / ScaleLimit * 4m;
    private decimal CurrentGPA {
        get {
            if (!grades.Any())
                return 0;

            int credits = grades.Sum(g => g.Credits);

            if (credits == 0)
                return 0;

            decimal total = grades.Sum(g =>
                GetGradePoint(g.Score) * g.Credits);

            return total / credits;
        }
    }

    private decimal AverageScore =>
        grades.Any()
            ? grades.Average(g => g.Score)
            : 0;

    private int TotalCredits =>
        grades.Sum(g => g.Credits);

    private decimal GpaPercentage =>
        ScaleLimit == 0 ? 0 : Math.Clamp(CurrentGPA / ScaleLimit * 100m, 0m, 100m);

    private string PerformanceLabel =>
        NormalizedGpa >= 3.7m ? "Excellent Performance!" :
        NormalizedGpa >= 3.0m ? "Good Performance!" :
        NormalizedGpa >= 2.0m ? "Satisfactory Performance" :
        grades.Any() ? "Needs Improvement" : "No Grades Yet";

    private string PerformanceDescription =>
        NormalizedGpa >= 3.7m ? "Keep up your excellent academic progress." :
        NormalizedGpa >= 3.0m ? "You are making good academic progress." :
        NormalizedGpa >= 2.0m ? "Keep working towards your academic goals." :
        grades.Any() ? "Focus on improving your academic results." :
        "Add your grades to see your progress.";

    // GRADE DISTRIBUTION

    private List<DistributionItem> Distribution {
        get {
            var groups = new[]
            {
                new { Label = "A / A-", Css = "distribution-a", Match = "A" },
                new { Label = "B Range", Css = "distribution-b", Match = "B" },
                new { Label = "C Range", Css = "distribution-c", Match = "C" },
                new { Label = "D", Css = "distribution-d", Match = "D" },
                new { Label = "F", Css = "distribution-f", Match = "F" }
            };

            return groups.Select(group => {
                int count = grades.Count(g =>
                    GetLetter(g.Score).StartsWith(group.Match));

                decimal percentage = grades.Count == 0
                    ? 0
                    : count * 100m / grades.Count;

                return new DistributionItem {
                    Label = group.Label,
                    CssClass = group.Css,
                    Count = count,
                    Percentage = percentage
                };

            }).ToList();
        }
    }

    // GPA SCALE

    private decimal GetGradePoint(decimal score) {
        if (ScaleLimit == 100m) return score;
        decimal factor = ScaleLimit / 4m;
        if (score >= 95) return 4.00m * factor;
        if (score >= 90) return 3.67m * factor;
        if (score >= 85) return 3.33m * factor;
        if (score >= 80) return 3.00m * factor;
        if (score >= 75) return 2.67m * factor;
        if (score >= 70) return 2.33m * factor;
        if (score >= 65) return 2.00m * factor;
        if (score >= 60) return 1.67m * factor;
        if (score >= 50) return 1.00m * factor;

        return 0;
    }

    private string GetLetter(decimal score) {
        if (score >= 95) return "A";
        if (score >= 90) return "A-";
        if (score >= 85) return "B+";
        if (score >= 80) return "B";
        if (score >= 75) return "B-";
        if (score >= 70) return "C+";
        if (score >= 65) return "C";
        if (score >= 60) return "C-";
        if (score >= 50) return "D";

        return "F";
    }

    private string GradeClass(decimal score) {
        if (score >= 90) return "grade-a";
        if (score >= 80) return "grade-b";
        if (score >= 70) return "grade-c";
        if (score >= 50) return "grade-d";

        return "grade-f";
    }

    // CREATE

    private void OpenCreateModal() {
        formModel = new GradeModel {
            Date = DateTime.Today,
            Credits = 3
        };

        isEditing = false;
        showModal = true;
    }

    // EDIT

    private void EditGrade(GradeModel grade) {
        editingId = grade.Id;

        formModel = new GradeModel {
            Id = grade.Id,
            Course = grade.Course,
            Assessment = grade.Assessment,
            Score = grade.Score,
            Credits = grade.Credits,
            Date = grade.Date
        };

        isEditing = true;
        showModal = true;
    }

    // SAVE

    private async Task SaveGrade() {
        try {
            if (isEditing) await GradeService.UpdateAsync(formModel);
            else await GradeService.CreateAsync(formModel);
            grades = await GradeService.GetAllAsync();
            errorMessage = "";
            CloseModal();
        } catch (Exception ex) { errorMessage = $"Could not save grade: {ex.Message}"; }
    }

    // DELETE

    private async Task DeleteGrade(int id) {
        try {
            await GradeService.DeleteAsync(id);
            grades = await GradeService.GetAllAsync();
            errorMessage = "";
        } catch (Exception ex) { errorMessage = $"Could not delete grade: {ex.Message}"; }
    }

    // FILTER RESET

    private void ResetFilters() {
        searchTerm = "";
        letterFilter = "All";
    }

    private void HandleModalKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") CloseModal(); }

    // CLOSE

    private void CloseModal() {
        showModal = false;
    }

}
