@page "/grades"
@attribute [Authorize]
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@inject ILogger<Grades> Logger

<PageTitle>Grades & Analytics | StudentPlanner</PageTitle>

<div class="grades-page">

    @if (!string.IsNullOrWhiteSpace(errorMessage)) { <p class="settings-message" role="alert">@errorMessage</p> }

    <!-- HEADER -->

    <div class="grades-heading">
        <div>
            <span class="grades-eyebrow">ACADEMIC PERFORMANCE</span>
            <h1>Grades & Analytics</h1>
            <p>Track your academic progress and monitor your GPA.</p>
        </div>

        <button class="grades-primary-button" @onclick="OpenCreateModal">
            + Add Grade
        </button>
    </div>

    <!-- STATISTICS -->

    <div class="grades-stats">

        <div class="grade-stat-card">
            <div class="grade-stat-icon purple">★</div>
            <div>
                <span>Current GPA</span>
                <strong>@CurrentGPA.ToString("0.00") <small>/ @((int)gpaScale).ToString("0.00")</small></strong>
            </div>
        </div>

        <div class="grade-stat-card">
            <div class="grade-stat-icon blue">▤</div>
            <div>
                <span>Recorded Grades</span>
                <strong>@grades.Count</strong>
            </div>
        </div>

        <div class="grade-stat-card">
            <div class="grade-stat-icon green">✓</div>
            <div>
                <span>Average Score</span>
                <strong>@AverageScore.ToString("0.0")%</strong>
            </div>
        </div>

        <div class="grade-stat-card">
            <div class="grade-stat-icon orange">◆</div>
            <div>
                <span>Highest Score</span>
                <strong>@(grades.Any() ? $"{grades.Max(g => g.Score):0}%" : "0%")</strong>
            </div>
        </div>

    </div>

    <!-- GPA OVERVIEW -->

    <div class="grades-overview-grid">

        <section class="gpa-card">

            <div class="grades-section-heading">
                <div>
                    <h2>GPA Overview</h2>
                    <p>Your overall academic performance</p>
                </div>
            </div>

            <div class="gpa-visual">

                <div class="gpa-circle"
                     style="@($"background: conic-gradient(#7167ed 0% {GpaPercentage}%, var(--border) {GpaPercentage}% 100%)")">

                    <div class="gpa-circle-inner">
                        <strong>@CurrentGPA.ToString("0.00")</strong>
                <span>OUT OF @((int)gpaScale).ToString("0.00")</span>
                    </div>

                </div>

                <div class="gpa-description">
                    <strong>@PerformanceLabel</strong>
                    <span>@PerformanceDescription</span>
                </div>

            </div>

            <div class="gpa-details">

                <div>
                    <span>Academic Target</span>
            <strong>@((int)gpaScale).ToString("0.00") GPA</strong>
                </div>

                <div>
                    <span>Current Performance</span>
                    <strong>@GpaPercentage.ToString("0.0")%</strong>
                </div>

                <div>
                    <span>Total Credits</span>
                    <strong>@TotalCredits</strong>
                </div>

            </div>

        </section>

        <!-- GRADE DISTRIBUTION -->

        <section class="distribution-card">

            <div class="grades-section-heading">
                <div>
                    <h2>Grade Distribution</h2>
                    <p>Breakdown of your academic results</p>
                </div>
            </div>

            @foreach (var item in Distribution) {
                <div class="distribution-row">

                    <div class="distribution-label">
                        <strong>@item.Label</strong>
                        <span>@item.Count grades</span>
                    </div>

                    <div class="distribution-track">
                        <div class="distribution-fill @item.CssClass"
                             style="@($"width: {item.Percentage}%")">
                        </div>
                    </div>

                    <strong class="distribution-percentage">
                        @item.Percentage.ToString("0")%
                    </strong>

                </div>
            }

            @if (!grades.Any()) {
                <div class="grades-empty-small">
                    No grades available yet.
                </div>
            }

        </section>

    </div>

    <!-- PERFORMANCE CHART -->

    <section class="performance-card">

        <div class="grades-section-heading">
            <div>
                <h2>Academic Performance</h2>
                <p>Compare your scores across different subjects.</p>
            </div>
        </div>

        @if (grades.Any()) {
            <div class="performance-chart">

                @foreach (var grade in grades.OrderBy(g => g.CourseName)) {
                    <div class="chart-column">

                        <span class="chart-value">
                            @grade.Score.ToString("0")%
                        </span>

                        <div class="chart-bar-area">
                            <div class="chart-bar"
                                 style="@($"height: {grade.Score}%")">
                            </div>
                        </div>

                        <span class="chart-label" title="@grade.CourseName">
                            @grade.CourseName
                        </span>

                    </div>
                }

            </div>

            <div class="chart-axis">
                <span>0%</span>
                <span>25%</span>
                <span>50%</span>
                <span>75%</span>
                <span>100%</span>
            </div>
        } else {
            <div class="grades-empty-small">
                Add grades to see your performance chart.
            </div>
        }

    </section>

    <!-- GRADES TABLE -->

    <section class="grades-table-card">

        <div class="grades-table-heading">
            <div>
                <h2>My Grades</h2>
                <p>Manage your academic results.</p>
            </div>

            <span class="grades-results">
                @FilteredGrades.Count() results
            </span>
        </div>

        <!-- FILTERS -->

        <div class="grades-toolbar">

            <div class="grades-search">
                <span>⌕</span>

                <input type="text"
                       aria-label="Search grades by course or assessment"
                       placeholder="Search by course or assessment..."
                       @bind="searchTerm"
                       @bind:event="oninput" />
            </div>

            <select class="grades-filter" @bind="letterFilter">
                <option value="All">All Grades</option>
                <option value="A">A / A-</option>
                <option value="B">B / B+ / B-</option>
                <option value="C">C / C+ / C-</option>
                <option value="D">D</option>
                <option value="F">F</option>
            </select>

            <select class="grades-filter" @bind="sortBy" aria-label="Sort grades">
                <option value="Course">Sort by course</option>
                <option value="Date">Sort by date</option>
                <option value="Score">Sort by score</option>
            </select>

            <button class="grades-reset-button" @onclick="ResetFilters">
                Reset
            </button>

        </div>

        <!-- TABLE -->
        @if (!FilteredGrades.Any()) {
            <div class="grades-empty">
                <span>▤</span>
                <h3>No grades found</h3>
                <p>Try changing your filters or add a new grade.</p>
            </div>
        } else {
            <div class="grades-table-wrapper">

                <table class="grades-table">

                    <thead>
                        <tr>
                            <th>COURSE</th>
                            <th>ASSESSMENT</th>
                            <th>SCORE</th>
                            <th>LETTER</th>
                            <th>GPA POINT</th>
                            <th>CREDITS</th>
                            <th>DATE</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var grade in FilteredGrades) {
                            <tr @key="grade.Id">

                                <td>
                                    <strong>@grade.CourseName</strong>
                                </td>

                                <td>
                                    <span class="assessment-name">
                                        @grade.Title
                                    </span>
                                </td>

                                <td>
                                    <div class="score-cell">
                                        <strong>@grade.Score.ToString("0")%</strong>
                                        <div class="score-track">
                                            <div class="score-fill"
                                                 style="@($"width: {grade.Score}%")">
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="grade-letter @GradeClass(grade.Percentage)">
                                        @GetLetter(grade.Score)
                                    </span>
                                </td>

                                <td>
                    <strong>@GetGradePoint(grade.Percentage).ToString("0.00")</strong>
                                </td>

                                <td>@grade.Credits</td>

                                <td>@grade.Date.ToString("dd MMM yyyy")</td>

                                <td>
                                    <div class="grade-actions">

                                        <button title="Edit grade"
                                                @onclick="() => EditGrade(grade)">
                                            ✎
                                        </button>

                                        <button title="Delete grade"
                                                @onclick="() => RequestDeleteGrade(grade.Id)">
                                            🗑
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <div class="grades-table-footer">
            Showing @FilteredGrades.Count() of @grades.Count grades
        </div>

    </section>

</div>

@if (pendingDeleteId is not null) { <ConfirmDialog Title="Delete this grade?" Message="This action cannot be undone." ConfirmText="Delete grade" OnConfirm="ConfirmDeleteGrade" OnCancel="CancelDeleteGrade" /> }

<!-- ADD / EDIT MODAL -->
@if (showModal) {
    <div class="grades-modal-overlay" @onclick="CloseModal" @onkeydown="HandleModalKeyDown">

        <div class="grades-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" tabindex="-1">

            <div class="grades-modal-header">

                <div>
                    <span class="grades-eyebrow">GRADE MANAGEMENT</span>
                    <h2>@(isEditing ? "Edit Grade" : "Add New Grade")</h2>
                    <p>Enter your academic assessment results.</p>
                </div>

                <button class="grades-close-button" @onclick="CloseModal" @onkeydown="HandleModalKeyDown">
                    ×
                </button>

            </div>

            <EditForm Model="formModel" OnValidSubmit="SaveGrade" class="planner-form">

                <DataAnnotationsValidator />
                @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="grades-form-error" role="alert">@errorMessage</div> }

                <div class="grades-form-group">
                    <label>Course Name *</label>

                    <InputSelect class="grades-input" @bind-Value="formModel.CourseId">
                        <option value="0">Select a course</option>
                        @foreach (var course in courses) { <option value="@course.Id">@course.Code — @course.Name</option> }
                    </InputSelect>

                        <ValidationMessage For="@(() => formModel.CourseId)" />
                </div>

                <div class="grades-form-group">
                    <label>Assessment *</label>

                    <InputText class="grades-input"
                               @bind-Value="formModel.Title"
                               placeholder="e.g. Midterm Exam" />

                    <ValidationMessage For="@(() => formModel.Title)" />
                </div>

                <div class="grades-form-row">

                    <div class="grades-form-group">
                        <label>Score (%) *</label>

                        <InputNumber class="grades-input"
                                     @bind-Value="formModel.Score"
                                     step="0.5" />

                        <ValidationMessage For="@(() => formModel.Score)" />
                    </div>

                    <div class="grades-form-group">
                        <label>Credits *</label>

                        <InputNumber class="grades-input"
                                     @bind-Value="formModel.Credits" />

                        <ValidationMessage For="@(() => formModel.Credits)" />
                    </div>

                </div>

                <div class="grades-form-group">
                    <label>Date *</label>

                    <InputDate class="grades-input"
                               @bind-Value="formModel.Date" />
                </div>

                <div class="grades-preview">
                    <span>Calculated Grade</span>

                    <strong class="@GradeClass(formModel.Percentage)">
                        @GetLetter(formModel.Percentage)
                    </strong>

                    <span>
                        @GetGradePoint(formModel.Percentage).ToString("0.00") GPA
                    </span>
                </div>

                <div class="grades-modal-actions">

                    <button type="button"
                            class="grades-cancel-button"
                            @onclick="CloseModal" @onkeydown="HandleModalKeyDown">
                        Cancel
                    </button>

                    <button type="submit" class="grades-primary-button" disabled="@isSaving">
                        @(isSaving ? "Saving…" : isEditing ? "Save Changes" : "Add Grade")
                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}

@code {
    [Inject] private IGradeService GradeService { get; set; } = default!;
    [Inject] private ICourseService CourseService { get; set; } = default!;
    [Inject] private ISettingsService SettingsService { get; set; } = default!;
    private List<Grade> grades=new(); private List<Course> courses=new(); private GpaScale gpaScale=GpaScale.FourPoint;
    private string searchTerm="",letterFilter="All",sortBy="Course",errorMessage="";
    private bool showModal,isEditing,isSaving; private int editingId; private int? pendingDeleteId;
    private Grade formModel=new();
    private IEnumerable<Grade> FilteredGrades => (sortBy switch { "Date"=>grades.OrderByDescending(g=>g.Date), "Score"=>grades.OrderByDescending(g=>g.Percentage), _=>grades.OrderBy(g=>g.CourseName) }).Where(g=>(string.IsNullOrWhiteSpace(searchTerm)||g.CourseName.Contains(searchTerm,StringComparison.OrdinalIgnoreCase)||g.Title.Contains(searchTerm,StringComparison.OrdinalIgnoreCase))&&(letterFilter=="All"||GetLetter(g.Percentage).StartsWith(letterFilter,StringComparison.OrdinalIgnoreCase)));
    protected override async Task OnInitializedAsync(){GradeService.Changed+=OnChanged;CourseService.Changed+=OnChanged;SettingsService.Changed+=OnChanged;await LoadAsync();}
    private async Task LoadAsync(){try{grades=(await GradeService.GetGradesAsync()).ToList();courses=(await CourseService.GetCoursesAsync()).ToList();gpaScale=(await SettingsService.GetSettingsAsync()).GpaScale;errorMessage="";}catch(Exception ex){Logger.LogError(ex,"Grades could not be loaded.");errorMessage="Grades could not be loaded. Please try again.";}}
    private void OnChanged()=>_ = InvokeAsync(async()=>{await LoadAsync();StateHasChanged();});
    private decimal CurrentGPA=>GpaCalculator.Calculate(grades,courses,gpaScale);
    private decimal AverageScore=>grades.Count==0?0:grades.Average(g=>g.Percentage);
    private int TotalCredits=>courses.Where(c=>grades.Any(g=>g.CourseId==c.Id)).Sum(c=>c.Credits);
    private decimal GpaPercentage=>(int)gpaScale==0?0:CurrentGPA/(int)gpaScale*100m;
    private string PerformanceLabel=>grades.Count==0?"No Grades Yet":CurrentGPA>=((int)gpaScale*.9m)?"Excellent Performance!":CurrentGPA>=((int)gpaScale*.75m)?"Good Performance!":"Keep working towards your academic goals.";
    private string PerformanceDescription=>grades.Count==0?"Add your grades to see your progress.":"Your GPA uses the selected demonstration scale.";
    private List<DistributionItem> Distribution=>new (string Label,string Css,string Match)[]{("A / A-","distribution-a","A"),("B Range","distribution-b","B"),("C Range","distribution-c","C"),("D","distribution-d","D"),("F","distribution-f","F")}.Select(x=>{var count=grades.Count(g=>GetLetter(g.Percentage).StartsWith(x.Match));return new DistributionItem{Label=x.Label,CssClass=x.Css,Count=count,Percentage=grades.Count==0?0:count*100m/grades.Count};}).ToList();
    private sealed class DistributionItem{public string Label{get;set;}="";public string CssClass{get;set;}="";public int Count{get;set;}public decimal Percentage{get;set;}}
    private decimal GetGradePoint(decimal score)=>GpaCalculator.ConvertPercentage(score,gpaScale);
    private string GetLetter(decimal score)=>score>=90?"A":score>=80?"B":score>=70?"C":score>=60?"D":"F";
    private string GradeClass(decimal score)=>score>=90?"grade-a":score>=80?"grade-b":score>=70?"grade-c":score>=60?"grade-d":"grade-f";
    private void OpenCreateModal(){formModel=new Grade{Date=DateTime.Today,MaxScore=100,Weight=100,Credits=3};isEditing=false;showModal=true;}
    private void EditGrade(Grade grade){editingId=grade.Id;formModel=new Grade{Id=grade.Id,CourseId=grade.CourseId,CourseName=grade.CourseName,Title=grade.Title,Score=grade.Score,MaxScore=grade.MaxScore,Weight=grade.Weight,Credits=grade.Credits,Date=grade.Date};isEditing=true;showModal=true;}
    private async Task SaveGrade(){if(isSaving)return;isSaving=true;try{formModel.CourseName=courses.FirstOrDefault(c=>c.Id==formModel.CourseId)?.Code??"";if(isEditing)await GradeService.UpdateGradeAsync(formModel);else await GradeService.CreateGradeAsync(formModel);errorMessage="";await LoadAsync();CloseModal();}catch(ValidationException ex){errorMessage=ex.Message;}catch(Exception ex){Logger.LogError(ex,"Grade save failed for {GradeId}.",formModel.Id);errorMessage="The grade could not be saved. Please try again.";}finally{isSaving=false;}}
    private void RequestDeleteGrade(int id)=>pendingDeleteId=id;
    private Task CancelDeleteGrade(){pendingDeleteId=null;return Task.CompletedTask;}
    private async Task ConfirmDeleteGrade(){if(pendingDeleteId is int id){try{await GradeService.DeleteGradeAsync(id);pendingDeleteId=null;await LoadAsync();}catch(Exception ex){Logger.LogError(ex,"Grade deletion failed for {GradeId}.",id);errorMessage="The grade could not be deleted.";}}}
    private void ResetFilters(){searchTerm="";letterFilter="All";sortBy="Course";}
    private void CloseModal()=>showModal=false;
    private void HandleModalKeyDown(KeyboardEventArgs e){if(e.Key=="Escape"){showModal=false;pendingDeleteId=null;}}
    public void Dispose(){GradeService.Changed-=OnChanged;CourseService.Changed-=OnChanged;SettingsService.Changed-=OnChanged;}
}
