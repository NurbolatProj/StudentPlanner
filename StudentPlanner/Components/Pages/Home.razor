@page "/"
@using System.Linq
@inject IStudentService StudentService
@inject IAssignmentService AssignmentService
@inject ICourseService CourseService
@inject IGradeService GradeService
@inject IScheduleEventService ScheduleEventService
@inject IUserPreferencesService Preferences

<PageTitle>Dashboard | StudentPlanner</PageTitle>
@if (!string.IsNullOrWhiteSpace(errorMessage)) {
    <ErrorBanner Message="@errorMessage" />
}

<div class="dashboard">

    <!-- Welcome -->
    <div class="welcome-section">
        <div>
            <span class="welcome-label">STUDENT OVERVIEW</span>
            <h1>Welcome back, @StudentName! 👋</h1>
            <p>Here's what's happening with your studies today.</p>
        </div>

        <div class="date-card">
            <span>YOUR WORKSPACE</span>
            <strong>@DateTime.Now.ToString("dddd, MMMM dd")</strong>
        </div>
    </div>

    <!-- Statistics -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-icon purple">▤</span>
                <span class="stat-trend">Academic</span>
            </div>
            <span class="stat-title">Current GPA</span>
            <div class="stat-value">@CurrentGpa.ToString("0.00") <span>/ @ScaleLimit.ToString("0.##")</span></div>
            <div class="stat-progress">
                <div class="progress-fill purple-fill" style="width:@GpaPercentage%"></div>
            </div>
            <span class="stat-description">Calculated from shared grade records</span>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-icon blue">☑</span>
                <span class="stat-trend">This semester</span>
            </div>
            <span class="stat-title">Total Assignments</span>
            <div class="stat-value">@assignments.Count</div>
            <div class="stat-progress">
                <div class="progress-fill blue-fill"
                     style="width:@CompletionPercentage%"></div>
            </div>
            <span class="stat-description">@CompletedCount completed</span>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-icon orange">◷</span>
                <span class="stat-trend">Needs attention</span>
            </div>
            <span class="stat-title">Pending Tasks</span>
            <div class="stat-value">@PendingCount</div>
            <div class="stat-progress">
                <div class="progress-fill orange-fill" style="width:@PendingPercentage%"></div>
            </div>
            <span class="stat-description">Tasks waiting for completion</span>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-icon green">▣</span>
                <span class="stat-trend">Semester</span>
            </div>
            <span class="stat-title">Active Courses</span>
            <div class="stat-value">@courses.Count</div>
            <div class="stat-progress">
                <div class="progress-fill green-fill" style="width:@ActiveCoursePercentage%"></div>
            </div>
            <span class="stat-description">Courses currently enrolled</span>
        </div>

    </div>

    <!-- Main content -->
    <div class="dashboard-grid">

        <!-- Assignments -->
        <section class="dashboard-card assignments-panel">

            <div class="section-heading">
                <div>
                    <h2>My Assignments</h2>
                    <p>Keep track of your academic tasks</p>
                </div>
                <a href="/assignments" class="view-link">View all →</a>
            </div>

            <div class="task-list">

                @foreach (var task in assignments) {
                    <div class="task-item">
                        <button class="task-check @((task.Status == "Completed") ? "checked" : "")"
                                @onclick="() => ToggleTask(task)"
                                aria-label="Toggle task completion">
                            @((task.Status == "Completed") ? "✓" : "")
                        </button>

                        <div class="task-info">
                            <strong class="@((task.Status == "Completed") ? "task-done" : "")">
                                @task.Title
                            </strong>
                            <span>@task.Course · @task.DueDate.ToString("MMM dd")</span>
                        </div>

                        <span class="priority-badge @task.Priority.ToLower()">
                            @task.Priority
                        </span>
                    </div>
                }

            </div>

            <div class="task-summary">
                <span>Completion progress</span>
                <strong>@CompletionPercentage%</strong>
            </div>

            <div class="progress-track">
                <div class="progress-fill purple-fill"
                     style="width:@CompletionPercentage%"></div>
            </div>

        </section>

        <!-- GPA -->
        <section class="dashboard-card gpa-panel">

            <div class="section-heading">
                <div>
                    <h2>Academic Performance</h2>
                    <p>Your current academic overview</p>
                </div>
            </div>

            <div class="gpa-display">
                <div class="gpa-circle">
                    <div>
                        <strong>@CurrentGpa.ToString("0.00")</strong>
                        <span>OUT OF @ScaleLimit.ToString("0.##")</span>
                    </div>
                </div>
            </div>

            <div class="gpa-caption">
                <strong>Excellent progress!</strong>
                <span>Keep working towards your academic goals.</span>
            </div>

            <div class="performance-row">
                <span>Academic target</span>
                <strong>@ScaleLimit.ToString("0.##") GPA</strong>
            </div>

            <div class="performance-row">
                <span>Current performance</span>
                <strong>@GpaPercentage.ToString("0")%</strong>
            </div>

            <a href="/grades" class="full-link">View grade analytics →</a>

        </section>

        <!-- Deadlines -->
        <section class="dashboard-card deadlines-panel">

            <div class="section-heading">
                <div>
                    <h2>Upcoming Deadlines</h2>
                    <p>Don't miss important submissions</p>
                </div>
                <a href="/assignments" class="view-link">View all →</a>
            </div>

            @foreach (var deadline in deadlines) {
                <div class="deadline-item">
                    <div class="deadline-date">
                        <strong>@deadline.Day</strong>
                        <span>@deadline.Month</span>
                    </div>

                    <div class="deadline-info">
                        <strong>@deadline.Title</strong>
                        <span>@deadline.Course</span>
                    </div>

                    <span class="deadline-priority @deadline.Priority.ToLower()">
                        @deadline.Priority
                    </span>
                </div>
            }

        </section>

        <!-- Weekly progress -->
        <section class="dashboard-card weekly-panel">

            <div class="section-heading">
                <div>
                    <h2>Weekly Study Activity</h2>
                    <p>Events on your schedule this week</p>
                </div>
                <span class="weekly-total">@WeeklyTotal.ToString("0") events</span>
            </div>

            <div class="weekly-chart">
                @foreach (var day in weeklyActivity) {
                    <div class="chart-column">
                        <span class="chart-value">@day.Hours</span>
                        <div class="chart-bar-container">
                            <div class="chart-bar"
                                 style="height:@(day.Hours / 8 * 100)%">
                            </div>
                        </div>
                        <span class="chart-day">@day.Day</span>
                    </div>
                }
            </div>

            <div class="weekly-footer">
                <span>Weekly study goal</span>
                <strong>@WeeklyTotal.ToString("0") scheduled events this week</strong>
            </div>

            <div class="progress-track">
                <div class="progress-fill green-fill" style="width:@Math.Min(WeeklyTotal / 25d * 100d, 100d)%"></div>
            </div>

        </section>

    </div>

    <!-- Courses -->
    <section class="dashboard-card courses-panel">

        <div class="section-heading">
            <div>
                <h2>My Courses</h2>
                <p>Overview of your current semester</p>
            </div>
            <a href="/courses" class="view-link">All courses →</a>
        </div>

        <div class="courses-grid">

            @foreach (var course in courses) {
                <div class="course-item">
                    <div class="course-icon">@course.Icon</div>
                    <div class="course-info">
                        <strong>@course.Name</strong>
                        <span>@course.Code</span>
                    </div>
                    <div class="course-grade">
                        <strong>@course.Grade</strong>
                        <span>Current grade</span>
                    </div>
                </div>
            }

        </div>

    </section>

</div>


@code {
    private Student? student;
    private string errorMessage = "";
    private List<Assignment> assignmentRecords = [];
    private List<Course> courseRecords = [];
    private List<Grade> gradeRecords = [];
    private List<ScheduleEvent> scheduleRecords = [];
    private List<Assignment> assignments = [];
    private List<DeadlineItem> deadlines = [];
    private List<CourseItem> courses = [];
    private List<ActivityItem> weeklyActivity = [];

    private string StudentName => string.IsNullOrWhiteSpace(student?.FullName) ? "Student" : student.FullName;
    private int CompletedCount => assignments.Count(a => a.Status == "Completed");
    private int PendingCount => assignments.Count(a => a.Status != "Completed");
    private int CompletionPercentage => assignments.Count == 0 ? 0 : (int)Math.Round(CompletedCount * 100d / assignments.Count);
    private decimal ScaleLimit => Preferences.Current.GpaScale == "100" ? 100m : decimal.TryParse(Preferences.Current.GpaScale, out var scale) ? scale : 4m;
    private decimal CurrentGpa {
        get {
            var totalCredits = gradeRecords.Sum(g => g.Credits);
            return totalCredits <= 0 ? 0 : gradeRecords.Sum(g => (ScaleLimit == 100m ? g.Score : GradePoint(g.Score) * ScaleLimit / 4m) * g.Credits) / totalCredits;
        }
    }
    private decimal GpaPercentage => ScaleLimit == 0 ? 0 : Math.Clamp(CurrentGpa / ScaleLimit * 100m, 0m, 100m);
    private int PendingPercentage => assignments.Count == 0 ? 0 : (int)Math.Round(PendingCount * 100d / assignments.Count);
    private int ActiveCoursePercentage => courseRecords.Count == 0 ? 0 : (int)Math.Round(courseRecords.Count(c => c.IsActive) * 100d / courseRecords.Count);
    private double WeeklyTotal => weeklyActivity.Sum(x => x.Hours);

    protected override async Task OnInitializedAsync() {
        try {
            student = await StudentService.GetCurrentAsync();
            assignmentRecords = await AssignmentService.GetAllAsync();
            courseRecords = await CourseService.GetAllAsync();
            gradeRecords = await GradeService.GetAllAsync();
            scheduleRecords = await ScheduleEventService.GetAllAsync();
            RefreshData();
        } catch (Exception ex) { errorMessage = $"Could not load dashboard data: {ex.Message}"; }
    }

    private void RefreshData() {
        assignments = assignmentRecords.OrderBy(a => a.DueDate).ToList();
        deadlines = assignments.Where(a => a.Status != "Completed").Take(4)
            .Select(a => new DeadlineItem { Day = a.DueDate.ToString("dd"), Month = a.DueDate.ToString("MMM").ToUpperInvariant(), Title = a.Title, Course = a.Course, Priority = a.Priority }).ToList();
        courses = courseRecords.Where(c => c.IsActive).Select(c => new CourseItem {
            Icon = c.Color == "blue" ? "💻" : c.Color == "green" ? "📊" : "🗄️",
            Name = c.Name, Code = c.Code,
            Grade = gradeRecords.Where(g => g.Course == c.Code || g.Course == c.Name).Select(g => (string?)g.Score.ToString("0") + "%").FirstOrDefault() ?? "—"
        }).ToList();
        var weekStart = DateTime.Today.AddDays(-(((int)DateTime.Today.DayOfWeek + 6) % 7));
        weeklyActivity = Enumerable.Range(0, 7).Select(i => new ActivityItem {
            Day = weekStart.AddDays(i).ToString("ddd").ToUpperInvariant(),
            Hours = scheduleRecords.Count(e => e.Date.Date == weekStart.AddDays(i).Date)
        }).ToList();
    }

    private static decimal GradePoint(decimal score) =>
        score >= 95 ? 4.00m : score >= 90 ? 3.67m : score >= 85 ? 3.33m : score >= 80 ? 3.00m :
        score >= 75 ? 2.67m : score >= 70 ? 2.33m : score >= 65 ? 2.00m : score >= 60 ? 1.67m : score >= 50 ? 1.00m : 0m;

    private async Task ToggleTask(Assignment task) {
        try {
            task.Status = task.Status == "Completed" ? "Pending" : "Completed";
            await AssignmentService.UpdateAsync(task);
            assignmentRecords = await AssignmentService.GetAllAsync();
            RefreshData();
            errorMessage = "";
        } catch (Exception ex) { errorMessage = $"Could not update assignment: {ex.Message}"; }
    }

    private sealed class DeadlineItem { public string Day { get; set; } = ""; public string Month { get; set; } = ""; public string Title { get; set; } = ""; public string Course { get; set; } = ""; public string Priority { get; set; } = ""; }
    private sealed class CourseItem { public string Icon { get; set; } = ""; public string Name { get; set; } = ""; public string Code { get; set; } = ""; public string Grade { get; set; } = ""; }
    private sealed class ActivityItem { public string Day { get; set; } = ""; public double Hours { get; set; } }
}