@page "/"
@implements IDisposable
@using System.Linq

<PageTitle>Dashboard | StudentPlanner</PageTitle>

<div class="dashboard">

    @if (!string.IsNullOrWhiteSpace(loadError)) { <p class="settings-message" role="alert">@loadError</p> }

    <!-- Welcome -->
    <div class="welcome-section">
        <div>
            <span class="welcome-label">STUDENT OVERVIEW</span>
            <h1>Welcome back, Nurbolat! 👋</h1>
            <p>Here's what's happening with your studies today.</p>
        </div>

        <div class="date-card">
            <span>YOUR WORKSPACE</span>
            <strong>@DateTime.Now.ToString("dddd, MMMM dd")</strong>
        </div>
    </div>

    <!-- Statistics -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-icon purple">▤</span>
                <span class="stat-trend">Academic</span>
            </div>
            <span class="stat-title">Current GPA</span>
            <div class="stat-value">@CurrentGpa.ToString("0.00") <span>/ @ScaleMax.ToString("0.00")</span></div>
            <div class="stat-progress">
                <div class="progress-fill purple-fill" style="width:@GpaPercentage.ToString("0.0")%"></div>
            </div>
            <span class="stat-description">Weighted from current grades</span>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-icon blue">☑</span>
                <span class="stat-trend">This semester</span>
            </div>
            <span class="stat-title">Total Assignments</span>
            <div class="stat-value">@assignments.Count</div>
            <div class="stat-progress">
                <div class="progress-fill blue-fill"
                     style="width:@CompletionPercentage%"></div>
            </div>
            <span class="stat-description">@CompletedCount completed</span>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-icon orange">◷</span>
                <span class="stat-trend">Needs attention</span>
            </div>
            <span class="stat-title">Pending Tasks</span>
            <div class="stat-value">@PendingCount</div>
            <div class="stat-progress">
                <div class="progress-fill orange-fill" style="width:@(assignments.Count==0?0:Math.Min(100,OverdueCount*100/assignments.Count))%"></div>
            </div>
            <span class="stat-description">@OverdueCount overdue · Tasks waiting for completion</span>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-icon green">▣</span>
                <span class="stat-trend">Semester</span>
            </div>
            <span class="stat-title">Active Courses</span>
            <div class="stat-value">@courses.Count(c => c.IsActive)</div>
            <div class="stat-progress">
                <div class="progress-fill green-fill" style="width:@(Math.Min(100,courses.Count*10))%"></div>
            </div>
            <span class="stat-description">@courses.Count(c => c.IsActive) currently enrolled</span>
        </div>

    </div>

    <!-- Main content -->
    <div class="dashboard-grid">

        <!-- Assignments -->
        <section class="dashboard-card assignments-panel">

            <div class="section-heading">
                <div>
                    <h2>My Assignments</h2>
                    <p>Keep track of your academic tasks</p>
                </div>
                <a href="/assignments" class="view-link">View all →</a>
            </div>

            @if (priorityRecommendations.Count > 0) {
                <div class="priority-recommendations" aria-label="Recommended assignments">
                    <h3>Recommended next</h3>
                    @foreach (var recommendation in priorityRecommendations) {
                        <div class="priority-recommendation">
                            <span class="recommendation-score">@recommendation.PriorityScore.ToString("0")</span>
                            <div>
                                <strong>@recommendation.Title</strong>
                                <small>@recommendation.Reason</small>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="task-list">

                @foreach (var task in assignments) {
                    <div class="task-item">
                        <button class="task-check @(task.IsCompleted ? "checked" : "")"
                                @onclick="() => ToggleTask(task)"
                                aria-label="Toggle task completion">
                            @(task.IsCompleted ? "✓" : "")
                        </button>

                        <div class="task-info">
                            <strong class="@(task.IsCompleted ? "task-done" : "")">
                                @task.Title
                            </strong>
                            <span>@task.CourseName · @task.DueDate.ToString("MMM dd")</span>
                        </div>

                        <span class="priority-badge @task.Priority.ToString().ToLowerInvariant()">
                            @task.Priority
                        </span>
                    </div>
                }

            </div>

            <div class="task-summary">
                <span>Completion progress</span>
                <strong>@CompletionPercentage%</strong>
            </div>

            <div class="progress-track">
                <div class="progress-fill purple-fill"
                     style="width:@CompletionPercentage%"></div>
            </div>

        </section>

        <!-- GPA -->
        <section class="dashboard-card gpa-panel">

            <div class="section-heading">
                <div>
                    <h2>Academic Performance</h2>
                    <p>Your current academic overview</p>
                </div>
            </div>

            <div class="gpa-display">
                <div class="gpa-circle">
                    <div>
                        <strong>@CurrentGpa.ToString("0.00")</strong>
                        <span>OUT OF @ScaleMax.ToString("0.00")</span>
                    </div>
                </div>
            </div>

            <div class="gpa-caption">
                <strong>Excellent progress!</strong>
                <span>Keep working towards your academic goals.</span>
            </div>

            <div class="performance-row">
                <span>Academic target</span>
                <strong>@ScaleMax.ToString("0.00") GPA</strong>
            </div>

            <div class="performance-row">
                <span>Current performance</span>
                <strong>@GpaPercentage.ToString("0.0")%</strong>
            </div>

            <a href="/grades" class="full-link">View grade analytics →</a>

        </section>

        <!-- Deadlines -->
        <section class="dashboard-card deadlines-panel">

            <div class="section-heading">
                <div>
                    <h2>Upcoming Deadlines</h2>
                    <p>Don't miss important submissions</p>
                </div>
                <a href="/assignments" class="view-link">View all →</a>
            </div>

            @foreach (var deadline in deadlines) {
                <div class="deadline-item">
                    <div class="deadline-date">
                        <strong>@deadline.Day</strong>
                        <span>@deadline.Month</span>
                    </div>

                    <div class="deadline-info">
                        <strong>@deadline.Title</strong>
                        <span>@deadline.Course</span>
                    </div>

                    <span class="deadline-priority @deadline.Priority.ToLower()">
                        @deadline.Priority
                    </span>
                </div>
            }

        </section>

        <section class="dashboard-card weekly-panel">
            <div class="section-heading"><div><h2>Today schedule</h2><p>Events from your calendar</p></div></div>
            @if (todayEvents.Count == 0) { <p>No events scheduled today.</p> } else { @foreach (var item in todayEvents) { <div class="deadline-item"><div class="deadline-date"><strong>@item.StartTime.ToString("HH:mm")</strong><span>@item.Type</span></div><div class="deadline-info"><strong>@item.Title</strong><span>@item.CourseName</span></div></div> } }
        </section>

        <section class="dashboard-card deadlines-panel">
            <div class="section-heading"><div><h2>Recent activity</h2><p>Recently completed assignments</p></div></div>
            @if (!RecentlyCompleted.Any()) { <p>No recent completions yet.</p> } else { @foreach (var task in RecentlyCompleted) { <div class="deadline-item"><div class="deadline-date"><strong>@task.CompletedAt!.Value.ToString("dd")</strong><span>@task.CompletedAt.Value.ToString("MMM").ToUpperInvariant()</span></div><div class="deadline-info"><strong>@task.Title</strong><span>@task.CourseName</span></div></div> } }
        </section>

        <!-- Weekly progress -->
        <section class="dashboard-card weekly-panel">

            <div class="section-heading">
                <div>
                    <h2>Weekly Study Activity</h2>
                    <p>Your planned study hours</p>
                </div>
                <span class="weekly-total">@WeeklyHours.ToString("0.0") hrs</span>
            </div>

            <div class="weekly-chart">
                @foreach (var day in weeklyActivity) {
                    <div class="chart-column">
                        <span class="chart-value">@day.Hours</span>
                        <div class="chart-bar-container">
                            <div class="chart-bar"
                                 style="height:@(day.Hours / 8 * 100)%">
                            </div>
                        </div>
                        <span class="chart-day">@day.Day</span>
                    </div>
                }
            </div>

            <div class="weekly-footer">
                <span>Weekly study goal</span>
                <strong>@WeeklyHours.ToString("0.0") / 25 hours</strong>
            </div>

            <div class="progress-track">
                <div class="progress-fill green-fill" style="width:@Math.Min(100, WeeklyHours / 25 * 100)%"></div>
            </div>

        </section>

    </div>

    <!-- Courses -->
    <section class="dashboard-card courses-panel">

        <div class="section-heading">
            <div>
                <h2>My Courses</h2>
                <p>Overview of your current semester</p>
            </div>
            <a href="/courses" class="view-link">All courses →</a>
        </div>

        <div class="courses-grid">

            @foreach (var course in courses) {
                <div class="course-item">
                    <div class="course-icon">@CourseIcon(course.Color)</div>
                    <div class="course-info">
                        <strong>@course.Name</strong>
                        <span>@course.Code</span>
                    </div>
                    <div class="course-grade">
                        <strong>@GetCourseGrade(course.Id)</strong>
                        <span>Current grade</span>
                    </div>
                </div>
            }

        </div>

    </section>

</div>

@code {
    [Inject] private ICourseService CourseService { get; set; } = default!;
    [Inject] private IAssignmentService AssignmentService { get; set; } = default!;
    [Inject] private IGradeService GradeService { get; set; } = default!;
    [Inject] private IScheduleService ScheduleService { get; set; } = default!;
    [Inject] private ISettingsService SettingsService { get; set; } = default!;
    [Inject] private IDashboardService DashboardService { get; set; } = default!;
    [Inject] private IAssignmentPriorityService PriorityService { get; set; } = default!;
    [Inject] private ILogger<Home> Logger { get; set; } = default!;
    private List<Assignment> assignments=new(); private List<Course> courses=new(); private List<Grade> grades=new(); private List<ScheduleEvent> todayEvents=new();
    private IReadOnlyList<PrioritizedAssignmentDto> priorityRecommendations = Array.Empty<PrioritizedAssignmentDto>();
    private IEnumerable<Assignment> RecentlyCompleted=>assignments.Where(a=>a.CompletedAt.HasValue).OrderByDescending(a=>a.CompletedAt).Take(5);
    private List<DeadlineItem> deadlines=>assignments.Where(a=>a.Status!=AssignmentStatus.Completed).OrderBy(a=>a.DueDate).Take(3).Select(a=>new DeadlineItem{Day=a.DueDate.ToString("dd"),Month=a.DueDate.ToString("MMM").ToUpperInvariant(),Title=a.Title,Course=a.CourseName,Priority=a.Priority.ToString()}).ToList();
    private List<ActivityItem> weeklyActivity=>Enumerable.Range(0,7).Select(offset=>{var day=DateTime.Today.AddDays(-6+offset);var hours=assignments.Where(a=>a.CompletedAt?.Date==day.Date).Sum(a=>a.EstimatedMinutes)/60d;return new ActivityItem{Day=day.ToString("ddd").ToUpperInvariant(),Hours=hours};}).ToList();
    private double WeeklyHours=>weeklyActivity.Sum(a=>a.Hours);
    private decimal CurrentGpa=>GpaCalculator.Calculate(grades,courses,currentSettings.GpaScale);
    private decimal ScaleMax=>(int)currentSettings.GpaScale;
    private decimal GpaPercentage=>ScaleMax==0?0:CurrentGpa/ScaleMax*100m;
    private StudentSettings currentSettings=new();
    private string loadError = "";
    private int CompletedCount=>assignments.Count(a=>a.Status==AssignmentStatus.Completed);
    private int PendingCount=>assignments.Count(a=>a.Status!=AssignmentStatus.Completed);
    private int CompletionPercentage=>assignments.Count==0?0:(int)Math.Round(CompletedCount*100d/assignments.Count);
    private int OverdueCount=>assignments.Count(a=>a.Status!=AssignmentStatus.Completed&&a.DueDate.Date<DateTime.Today);
    private sealed class DeadlineItem{public string Day{get;set;}="";public string Month{get;set;}="";public string Title{get;set;}="";public string Course{get;set;}="";public string Priority{get;set;}="";}
    private sealed class ActivityItem{public string Day{get;set;}="";public double Hours{get;set;}}
    protected override async Task OnInitializedAsync(){CourseService.Changed+=OnChanged;AssignmentService.Changed+=OnChanged;GradeService.Changed+=OnChanged;ScheduleService.Changed+=OnChanged;SettingsService.Changed+=OnChanged;await LoadAsync();}
    private async Task LoadAsync(){try{courses=(await CourseService.GetCoursesAsync()).ToList();assignments=(await AssignmentService.GetAssignmentsAsync()).ToList();grades=(await GradeService.GetGradesAsync()).ToList();currentSettings=await SettingsService.GetSettingsAsync();var snap=await DashboardService.GetSnapshotAsync();todayEvents=snap.TodayEvents.ToList();priorityRecommendations=PriorityService.Prioritize(assignments,DateOnly.FromDateTime(DateTime.Today),3);loadError="";}catch(Exception ex){Logger.LogError(ex,"Dashboard data could not be loaded.");loadError="Dashboard data could not be refreshed. Please try again.";}}
    private void OnChanged()=>_ = InvokeAsync(async()=>{await LoadAsync();StateHasChanged();});
    private string CourseIcon(string color)=>color switch{"blue"=>"📘","green"=>"📊","orange"=>"📝","pink"=>"🌐",_=>"🗄️"};
    private string GetCourseGrade(int courseId){var items=grades.Where(g=>g.CourseId==courseId).ToList();if(items.Count==0)return "—";var pct=items.Sum(g=>g.Percentage*g.Weight)/Math.Max(1,items.Sum(g=>g.Weight));return pct>=90?"A":pct>=80?"B":pct>=70?"C":pct>=60?"D":"F";}
    private async Task ToggleTask(Assignment task){var previousStatus=task.Status;task.IsCompleted=!task.IsCompleted;try{var updated=await AssignmentService.UpdateAssignmentAsync(task);if(updated is null){task.Status=previousStatus;loadError="This assignment is no longer available.";}}catch(Exception ex){task.Status=previousStatus;Logger.LogError(ex,"Dashboard assignment status update failed for {AssignmentId}.",task.Id);loadError="The assignment status could not be updated.";await LoadAsync();}}
    public void Dispose(){CourseService.Changed-=OnChanged;AssignmentService.Changed-=OnChanged;GradeService.Changed-=OnChanged;ScheduleService.Changed-=OnChanged;SettingsService.Changed-=OnChanged;}
}
