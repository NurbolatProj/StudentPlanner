@page "/settings"
@using StudentPlanner.Components.Layout
@using System.Net.Mail
@inject IUserPreferencesService Preferences
@inject IStudentService StudentService

<PageTitle>Settings</PageTitle>

<div class="settings-page">

    <div class="settings-header">
        <div>
            <span class="settings-eyebrow">STUDENT WORKSPACE</span>
            <h1>@ST("title")</h1>
            <p>@ST("subtitle")</p>
        </div>
        <div class="settings-header-icon">⚙</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message)) {
        <div class="settings-message" role="status">@message</div>
    }

    <div class="settings-grid">

        <section class="settings-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("profile")</h2>
                    <p>@ST("profile_desc")</p>
                </div>
                <span class="card-icon">👤</span>
            </div>

            <div class="profile-heading">
                <div class="profile-avatar">@GetInitial()</div>
                <div>
                    <strong>@fullName</strong>
                    <span>@studentId</span>
                </div>
            </div>

            <div class="form-group">
                <label for="settings-full-name">@ST("full_name")</label>
                <input id="settings-full-name" @bind="fullName" autocomplete="name" />
            </div>

            <div class="form-group">
                <label for="settings-email">@ST("email")</label>
                <input id="settings-email" type="email" @bind="email" aria-label="Email address" autocomplete="email" />
            </div>

            <div class="form-group">
                <label for="settings-student-id">@ST("student_id")</label>
                <input id="settings-student-id" @bind="studentId" />
            </div>

            <div class="form-group">
                <label for="settings-program">@ST("program")</label>
                <input id="settings-program" @bind="program" />
            </div>
        </section>

        <section class="settings-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("appearance")</h2>
                    <p>@ST("appearance_desc")</p>
                </div>
                <span class="card-icon">🎨</span>
            </div>

            <div class="form-group">
                <label>@ST("theme")</label>
                <select @bind="theme" @bind:after="ApplyTheme">
                    <option value="Dark">Dark</option>
                    <option value="Light">Light</option>
                </select>
            </div>

            <div class="theme-options">
                <button class="theme-option @(theme == "Dark" ? "selected" : "")"
                        @onclick='() => ChooseTheme("Dark")'>
                    <span class="theme-option-icon">🌙</span>
                    <strong>Dark</strong>
                    <small>@ST("dark_desc")</small>
                    <span class="theme-check">@(theme == "Dark" ? "✓" : "")</span>
                </button>

                <button class="theme-option @(theme == "Light" ? "selected" : "")"
                        @onclick='() => ChooseTheme("Light")'>
                    <span class="theme-option-icon">☀️</span>
                    <strong>Light</strong>
                    <small>@ST("light_desc")</small>
                    <span class="theme-check">@(theme == "Light" ? "✓" : "")</span>
                </button>
            </div>
        </section>

        <section class="settings-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("notifications")</h2>
                    <p>@ST("notifications_desc")</p>
                </div>
                <span class="card-icon">🔔</span>
            </div>

            <div class="toggle-row">
                <div>
                    <strong>@ST("assignment_reminders")</strong>
                    <p>@ST("assignment_reminders_desc")</p>
                </div>
                <label class="switch">
                    <input type="checkbox" aria-label="Assignment reminders" @bind="assignmentNotifications" />
                    <span class="switch-slider"></span>
                </label>
            </div>

            <div class="toggle-row">
                <div>
                    <strong>@ST("exam_reminders")</strong>
                    <p>@ST("exam_reminders_desc")</p>
                </div>
                <label class="switch">
                    <input type="checkbox" aria-label="Exam reminders" @bind="examNotifications" />
                    <span class="switch-slider"></span>
                </label>
            </div>

            <div class="toggle-row">
                <div>
                    <strong>@ST("deadline_alerts")</strong>
                    <p>@ST("deadline_alerts_desc")</p>
                </div>
                <label class="switch">
                    <input type="checkbox" aria-label="Deadline alerts" @bind="deadlineNotifications" />
                    <span class="switch-slider"></span>
                </label>
            </div>

            <div class="toggle-row">
                <div>
                    <strong>@ST("weekly_summary")</strong>
                    <p>@ST("weekly_summary_desc")</p>
                </div>
                <label class="switch">
                    <input type="checkbox" aria-label="Weekly summary" @bind="weeklySummary" />
                    <span class="switch-slider"></span>
                </label>
            </div>
        </section>

        <section class="settings-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("language_region")</h2>
                    <p>@ST("language_desc")</p>
                </div>
                <span class="card-icon">🌐</span>
            </div>

            <div class="form-group">
                <label>@ST("language")</label>
                <select disabled aria-label="Application language"><option value="English">English</option></select>
            </div>

            <div class="form-group">
                <label>@ST("timezone")</label>
                <select @bind="timeZone">
                    <option value="Asia/Almaty">Astana / Almaty (UTC+5)</option>
                    <option value="UTC">UTC</option>
                    <option value="Europe/London">London</option>
                </select>
            </div>

            <div class="language-note">
                <span>ⓘ</span>
                @ST("language_note")
            </div>
        </section>

        <section class="settings-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("academic")</h2>
                    <p>@ST("academic_desc")</p>
                </div>
                <span class="card-icon">🎓</span>
            </div>

            <div class="form-group">
                <label>@ST("semester")</label>
                <select @bind="semester">
                    <option>1st Semester</option>
                    <option>2nd Semester</option>
                    <option>Summer Semester</option>
                </select>
            </div>

            <div class="form-group">
                <label>@ST("academic_year")</label>
                <select @bind="academicYear">
                    <option>2025-2026</option>
                    <option>2026-2027</option>
                    <option>2027-2028</option>
                </select>
            </div>

            <div class="form-group">
                <label>@ST("gpa_scale")</label>
                <select @bind="gpaScale">
                    <option value="4.0">4.0 Scale</option>
                    <option value="5.0">5.0 Scale</option>
                    <option value="100">100 Point Scale</option>
                </select>
            </div>
        </section>

        <section class="settings-card account-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("account")</h2>
                    <p>@ST("account_desc")</p>
                </div>
                <span class="card-icon">🛡️</span>
            </div>

            <div class="account-status">
                <span class="status-dot"></span>
                <div>
                    <strong>@ST("active")</strong>
                    <p>@ST("active_desc")</p>
                </div>
            </div>

            <button class="reset-button" @onclick="ResetSettings">
                ↺ @ST("reset")
            </button>
        </section>

    </div>

    <div class="settings-footer">
        <span>@ST("changes_note")</span>
        <div>
            <button class="reset-secondary" @onclick="ResetSettings">
                @ST("reset")
            </button>
            <button class="save-button" @onclick="SaveSettings">
                ✓ @ST("save")
            </button>
        </div>
    </div>

</div>

@code {
    [CascadingParameter]
    public MainLayout? Layout { get; set; }

    private Student? studentRecord;
    private string fullName = "Nurbolat Otep";
    private string email = "student@astanait.edu.kz";
    private string studentId = "IT-2508";
    private string program = "Computer Science";

    private string theme = "Dark";
    private string language = "English";
    private string timeZone = "Asia/Almaty";

    private string semester = "2nd Semester";
    private string academicYear = "2026-2027";
    private string gpaScale = "4.0";

    private bool assignmentNotifications = true;
    private bool examNotifications = true;
    private bool deadlineNotifications = true;
    private bool weeklySummary;

    private string message = "";
    private bool preferencesLoaded;

    protected override async Task OnInitializedAsync() {
        studentRecord = await StudentService.GetCurrentAsync();
        if (studentRecord is null) return;
        fullName = studentRecord.FullName;
        email = studentRecord.Email;
        studentId = studentRecord.StudentId;
        program = studentRecord.Program;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || preferencesLoaded) return;
        var saved = await Preferences.LoadAsync();
        theme = saved.Theme; language = "English"; timeZone = saved.TimeZone;
        semester = saved.Semester; academicYear = saved.AcademicYear; gpaScale = saved.GpaScale;
        assignmentNotifications = saved.AssignmentNotifications; examNotifications = saved.ExamNotifications;
        deadlineNotifications = saved.DeadlineNotifications; weeklySummary = saved.WeeklySummary;
        if (!string.IsNullOrWhiteSpace(saved.FullName)) fullName = saved.FullName;
        if (!string.IsNullOrWhiteSpace(saved.Email)) email = saved.Email;
        if (!string.IsNullOrWhiteSpace(saved.StudentId)) studentId = saved.StudentId;
        if (!string.IsNullOrWhiteSpace(saved.Program)) program = saved.Program;

        Layout?.SetTheme(theme);
        preferencesLoaded = true;
        StateHasChanged();
    }

    private void ApplyTheme() {
        Layout?.SetTheme(theme);
    }

    private void ChooseTheme(string selectedTheme) {
        theme = selectedTheme;
        ApplyTheme();
    }

    private void ApplyLanguage() {
        Layout?.SetLanguage(language);
    }

    private string GetInitial() {
        return string.IsNullOrWhiteSpace(fullName)
            ? "N"
            : fullName.Trim().Substring(0, 1).ToUpper();
    }

    private async Task SaveSettings() {
        if (string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(studentId) ||
            !MailAddress.TryCreate(email, out var parsedEmail) || parsedEmail.Address != email.Trim()) {
            message = ST("validation_error");
            return;
        }
        if (studentRecord is null) { message = "Student profile could not be loaded."; return; }

        try {
            studentRecord.FullName = fullName.Trim();
            studentRecord.Email = email.Trim();
            studentRecord.StudentId = studentId.Trim();
            studentRecord.Program = program.Trim();
            await StudentService.UpdateAsync(studentRecord);
            ApplyTheme();
            await Preferences.SaveAsync(new UserPreferences {
                Theme = theme, Language = "English", TimeZone = timeZone, Semester = semester,
                AcademicYear = academicYear, GpaScale = gpaScale,
                AssignmentNotifications = assignmentNotifications, ExamNotifications = examNotifications,
                DeadlineNotifications = deadlineNotifications, WeeklySummary = weeklySummary,
                FullName = fullName.Trim(), Email = email.Trim(), StudentId = studentId.Trim(), Program = program.Trim()
            });
            message = ST("saved");
        } catch (Exception ex) { message = $"Could not save settings: {ex.Message}"; }
    }

    private async Task ResetSettings() {
        var defaults = new UserPreferences();
        fullName = "Nurbolat Otep"; email = "student@astanait.edu.kz";
        studentId = "IT-2508"; program = "Computer Science";
        theme = defaults.Theme; language = "English"; timeZone = defaults.TimeZone;
        semester = defaults.Semester; academicYear = defaults.AcademicYear; gpaScale = defaults.GpaScale;
        assignmentNotifications = defaults.AssignmentNotifications;
        examNotifications = defaults.ExamNotifications;
        deadlineNotifications = defaults.DeadlineNotifications;
        weeklySummary = defaults.WeeklySummary;

        try {
            if (studentRecord is not null) {
                studentRecord.FullName = fullName;
                studentRecord.Email = email;
                studentRecord.StudentId = studentId;
                studentRecord.Program = program;
                await StudentService.UpdateAsync(studentRecord);
            }
            ApplyTheme();
            await Preferences.SaveAsync(defaults);
            message = ST("reset_done");
        } catch (Exception ex) { message = $"Could not reset settings: {ex.Message}"; }
    }

