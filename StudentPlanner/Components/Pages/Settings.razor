@page "/settings"
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@using StudentPlanner.Components.Layout

<PageTitle>Settings</PageTitle>

<div class="settings-page">

    <div class="settings-header">
        <div>
            <span class="settings-eyebrow">STUDENT WORKSPACE</span>
            <h1>@ST("title")</h1>
            <p>@ST("subtitle")</p>
        </div>
        <div class="settings-header-icon">⚙</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message)) {
        <div class="settings-message">@message</div>
    }

    <div class="settings-grid">

        <section class="settings-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("profile")</h2>
                    <p>@ST("profile_desc")</p>
                </div>
                <span class="card-icon">👤</span>
            </div>

            <div class="profile-heading">
                <div class="profile-avatar">@GetInitial()</div>
                <div>
                    <strong>@fullName</strong>
                    <span>@studentId</span>
                </div>
            </div>

            <div class="form-group">
                <label>@ST("full_name")</label>
                <input @bind="fullName" />
            </div>

            <div class="form-group">
                <label>@ST("email")</label>
                <input type="email" @bind="email" aria-describedby="email-validation" />
            </div>

            <div id="email-validation" class="validation-message" role="alert">@emailError</div>
            <div class="form-group">
                <label>@ST("student_id")</label>
                <input @bind="studentId" />
            </div>

            <div class="form-group">
                <label>@ST("program")</label>
                <input @bind="program" />
            </div>
        </section>

        <section class="settings-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("appearance")</h2>
                    <p>@ST("appearance_desc")</p>
                </div>
                <span class="card-icon">🎨</span>
            </div>

            <div class="form-group">
                <label>@ST("theme")</label>
                <select @bind="theme" @bind:after="ApplyTheme">
                    <option value="Dark">Dark</option>
                    <option value="Light">Light</option>
                </select>
            </div>

            <div class="theme-options">
                <button class="theme-option @(theme == "Dark" ? "selected" : "")"
                        @onclick='() => ChooseTheme("Dark")'>
                    <span class="theme-option-icon">🌙</span>
                    <strong>Dark</strong>
                    <small>@ST("dark_desc")</small>
                    <span class="theme-check">@(theme == "Dark" ? "✓" : "")</span>
                </button>

                <button class="theme-option @(theme == "Light" ? "selected" : "")"
                        @onclick='() => ChooseTheme("Light")'>
                    <span class="theme-option-icon">☀️</span>
                    <strong>Light</strong>
                    <small>@ST("light_desc")</small>
                    <span class="theme-check">@(theme == "Light" ? "✓" : "")</span>
                </button>
            </div>
        </section>

        <section class="settings-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("notifications")</h2>
                    <p>@ST("notifications_desc")</p>
                </div>
                <span class="card-icon">🔔</span>
            </div>

            <div class="toggle-row">
                <div>
                    <strong>@ST("assignment_reminders")</strong>
                    <p>@ST("assignment_reminders_desc")</p>
                </div>
                <label class="switch">
                    <input type="checkbox" @bind="assignmentNotifications" />
                    <span class="switch-slider"></span>
                </label>
            </div>

            <div class="toggle-row">
                <div>
                    <strong>@ST("exam_reminders")</strong>
                    <p>@ST("exam_reminders_desc")</p>
                </div>
                <label class="switch">
                    <input type="checkbox" @bind="examNotifications" />
                    <span class="switch-slider"></span>
                </label>
            </div>

            <div class="toggle-row">
                <div>
                    <strong>@ST("deadline_alerts")</strong>
                    <p>@ST("deadline_alerts_desc")</p>
                </div>
                <label class="switch">
                    <input type="checkbox" @bind="deadlineNotifications" />
                    <span class="switch-slider"></span>
                </label>
            </div>

            <div class="toggle-row">
                <div>
                    <strong>@ST("weekly_summary")</strong>
                    <p>@ST("weekly_summary_desc")</p>
                </div>
                <label class="switch">
                    <input type="checkbox" @bind="weeklySummary" />
                    <span class="switch-slider"></span>
                </label>
            </div>
        </section>

        <section class="settings-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("language_region")</h2>
                    <p>@ST("language_desc")</p>
                </div>
                <span class="card-icon">🌐</span>
            </div>

            <div class="form-group">
                <label>@ST("language")</label>
                <select @bind="language" @bind:after="ApplyLanguage">
                    <option value="English">English</option>

                </select>
            </div>

            <div class="form-group">
                <label>@ST("timezone")</label>
                <select @bind="timeZone">
                    <option value="Asia/Almaty">Astana / Almaty (UTC+5)</option>
                    <option value="UTC">UTC</option>
                    <option value="Europe/London">London</option>
                </select>
            </div>

            <div class="language-note">
                <span>ⓘ</span>
                @ST("language_note")
            </div>
        </section>

        <section class="settings-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("academic")</h2>
                    <p>@ST("academic_desc")</p>
                </div>
                <span class="card-icon">🎓</span>
            </div>

            <div class="form-group">
                <label>@ST("semester")</label>
                <select @bind="semester">
                    <option>1st Semester</option>
                    <option>2nd Semester</option>
                    <option>Summer Semester</option>
                </select>
            </div>

            <div class="form-group">
                <label>@ST("academic_year")</label>
                <select @bind="academicYear">
                    <option>2025-2026</option>
                    <option>2026-2027</option>
                    <option>2027-2028</option>
                </select>
            </div>

            <div class="form-group">
                <label>@ST("gpa_scale")</label>
                <select @bind="gpaScale">
                    <option value="4.0">4.0 Scale</option>
                    <option value="5.0">5.0 Scale</option>
                    <option value="100">100 Point Scale</option>
                </select>
            </div>
        </section>

        <section class="settings-card account-card">
            <div class="card-heading">
                <div>
                    <h2>@ST("account")</h2>
                    <p>@ST("account_desc")</p>
                </div>
                <span class="card-icon">🛡️</span>
            </div>

            <div class="account-status">
                <span class="status-dot"></span>
                <div>
                    <strong>@ST("active")</strong>
                    <p>@ST("active_desc")</p>
                </div>
            </div>

            <button class="reset-button" @onclick="ResetSettings">
                ↺ @ST("reset")
            </button>
        </section>

    </div>

    <div class="settings-footer">
        <span>@ST("changes_note")</span>
        <div>
            <button class="reset-secondary" @onclick="ResetSettings">
                @ST("reset")
            </button>
            <button class="save-button" @onclick="SaveSettings">
                ✓ @ST("save")
            </button>
        </div>
    </div>

</div>

@code {
    [CascadingParameter]
    public MainLayout? Layout { get; set; }
    [Inject] private ISettingsService SettingsService { get; set; } = default!;
    [Inject] private ISettingsInitializer SettingsInitializer { get; set; } = default!;
    [Inject] private ILogger<Settings> Logger { get; set; } = default!;

    private string fullName = "Nurbolat Otep";
    private string email = "student@astanait.edu.kz";
    private string studentId = "IT-2508";
    private string program = "Computer Science";

    private string theme = "Dark";
    private string language = "English";
    private string timeZone = "Asia/Almaty";

    private string semester = "2nd Semester";
    private string academicYear = "2026-2027";
    private string gpaScale = "4.0";

    private bool assignmentNotifications = true;
    private bool examNotifications = true;
    private bool deadlineNotifications = true;
    private bool weeklySummary;

    private string message = "";
    private string emailError = "";

    protected override void OnInitialized() => SettingsService.Changed += OnSettingsChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        await SettingsInitializer.InitializeAsync();
        var settings = await SettingsService.GetSettingsAsync();
        fullName=settings.FullName; email=settings.Email; theme=settings.Theme.ToString(); language="English";
        timeZone=settings.TimeZone; semester=settings.Semester; academicYear=settings.AcademicYear; gpaScale=((int)settings.GpaScale).ToString("0.0");
        assignmentNotifications=settings.NotificationPreferences.AssignmentReminders; examNotifications=settings.NotificationPreferences.ExamReminders;
        deadlineNotifications=settings.NotificationPreferences.DeadlineAlerts; weeklySummary=settings.NotificationPreferences.WeeklySummary;
        studentId=settings.StudentId; program=settings.Program;
        Layout?.SetTheme(theme); StateHasChanged();
    }
    private void OnSettingsChanged() => _ = InvokeAsync(StateHasChanged);

    private void ApplyTheme() {
        Layout?.SetTheme(theme);
    }

    private void ChooseTheme(string selectedTheme) {
        theme = selectedTheme;
        ApplyTheme();
    }

    private void ApplyLanguage() {
        Layout?.SetLanguage(language);
    }

    private string GetInitial() {
        return string.IsNullOrWhiteSpace(fullName)
            ? "N"
            : fullName.Trim().Substring(0, 1).ToUpper();
    }

    private async Task SaveSettings() {
        var student = new Student { FullName = fullName, Email = email };
        var results = new List<ValidationResult>();
        if (!Validator.TryValidateObject(student, new ValidationContext(student), results, true)) {
            emailError = results.FirstOrDefault(r => r.MemberNames.Contains(nameof(Student.Email)))?.ErrorMessage ?? "Please enter a valid email address.";
            message = ST("validation_error");
            return;
        }
        if (!decimal.TryParse(gpaScale, out var scaleValue) || !Enum.IsDefined(typeof(GpaScale), (int)scaleValue)) {
            message = "Select a supported GPA scale."; return;
        }
        emailError = "";
        var settings = new StudentSettings { FullName=fullName, StudentId=studentId, Program=program, Email=email, Theme=Enum.Parse<ThemePreference>(theme), Language=AppLanguage.English,
            TimeZone=timeZone, Semester=semester, AcademicYear=academicYear, GpaScale=(GpaScale)(int)scaleValue,
            NotificationPreferences=new(){AssignmentReminders=assignmentNotifications,ExamReminders=examNotifications,DeadlineAlerts=deadlineNotifications,WeeklySummary=weeklySummary} };
        try { await SettingsService.SaveSettingsAsync(settings); ApplyTheme(); ApplyLanguage(); message="Settings saved in this browser."; }
        catch (Exception ex) { Logger.LogError(ex, "Settings could not be saved."); message="Settings could not be saved in this browser."; }
    }
    private async Task ResetSettings() {
        fullName = "Nurbolat Otep";
        email = "student@astanait.edu.kz";
        studentId = "IT-2508";
        program = "Computer Science";

        theme = "Dark";
        language = "English";
        timeZone = "Asia/Almaty";

        semester = "2nd Semester";
        academicYear = "2026-2027";
        gpaScale = "4.0";

        assignmentNotifications = true;
        examNotifications = true;
        deadlineNotifications = true;
        weeklySummary = false;

        ApplyTheme();
        ApplyLanguage();

        message = ST("reset_done");
        await SaveSettings();
    }

    private string ST(string key) => new Dictionary<string,string> {
        ["title"]="Settings",["subtitle"]="Manage your account and application preferences.",["profile"]="Profile Settings",["profile_desc"]="Update your personal information.",["full_name"]="Full Name",["email"]="Email Address",["student_id"]="Student ID",["program"]="Study Program",["appearance"]="Appearance",["appearance_desc"]="Customize how StudentPlanner looks.",["theme"]="Theme",["dark_desc"]="Dark appearance",["light_desc"]="Light appearance",["notifications"]="Notifications",["notifications_desc"]="Control which notifications you receive.",["assignment_reminders"]="Assignment Reminders",["assignment_reminders_desc"]="Get reminded about upcoming assignments.",["exam_reminders"]="Exam Reminders",["exam_reminders_desc"]="Receive notifications before exams.",["deadline_alerts"]="Deadline Alerts",["deadline_alerts_desc"]="Get notified about approaching deadlines.",["weekly_summary"]="Weekly Summary",["weekly_summary_desc"]="Receive a weekly study progress summary.",["language_region"]="Language & Region",["language_desc"]="Set your language and regional preferences.",["language"]="Application Language",["timezone"]="Time Zone",["language_note"]="The application currently supports English.",["academic"]="Academic Preferences",["academic_desc"]="Configure your academic information.",["semester"]="Current Semester",["academic_year"]="Academic Year",["gpa_scale"]="GPA Scale",["account"]="Account",["account_desc"]="Account status.",["active"]="Account Active",["active_desc"]="Everything is working normally.",["reset"]="Reset Settings",["changes_note"]="Remember to save your changes.",["save"]="Save Changes",["saved"]="Settings saved.",["reset_done"]="Settings have been reset.",["validation_error"]="Please check your name and email address."
    }.GetValueOrDefault(key,key);
    public void Dispose() => SettingsService.Changed -= OnSettingsChanged;
}
